# ISTA-DASLab GSQ-RCO GGUF pulled via hf.co arrives with a bare {{ .Prompt }} template
# (no chat formatting, thinking not parsed). Reuse the official qwen3.8 renderer/parser
# and sampling defaults so it behaves like qwen3.8:27b.
FROM hf.co/ISTA-DASLab/Qwen3.8-27B-GSQ-RCO-GGUF:IQ3_XXS
TEMPLATE {{ .Prompt }}
RENDERER qwen3.8
PARSER qwen3.5
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER min_p 0
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1
PARAMETER temperature 1
