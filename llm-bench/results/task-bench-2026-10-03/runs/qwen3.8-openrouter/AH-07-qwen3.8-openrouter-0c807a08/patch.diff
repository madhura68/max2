+import { describe, expect, it } from 'vitest'
+import { capDocArgs, DOC_MAX_CHARS } from '../src/worker/doc-tools.js'
+import type { ToolExecResult, ToolRegistry, ToolSnapshotEntry } from '../src/types.js'
+
+const sig = () => AbortSignal.timeout(5000)
+
+function fakeView(names: string[], calls: Array<{ name: string; args: Record<string, unknown> }>): {
+  view: ToolRegistry
+  closed: () => boolean
+} {
+  let closed = false
+  const entries: ToolSnapshotEntry[] = names.map((name) => ({ name, inputSchema: { type: 'object', properties: {} } }))
+  const view: ToolRegistry = {
+    snapshot: { entries, hash: 'test-hash' },
+    toOpenAiTools() {
+      return entries.map((e) => ({ type: 'function', function: { name: e.name, parameters: e.inputSchema } }))
+    },
+    async execute(name, args): Promise<ToolExecResult> {
+      calls.push({ name, args })
+      return { ok: true, content: `${name} called`, truncated: false }
+    },
+    async close(): Promise<void> {
+      closed = true
+    },
+  }
+  return { view, closed: () => closed }
+}
+
+describe('capDocArgs', () => {
+  it('lowers max_chars above the cap to 12 000, keeping offset and heading', async () => {
+    const calls: Array<{ name: string; args: Record<string, unknown> }> = []
+    const { view } = fakeView(['get_product_doc'], calls)
+    const capped = capDocArgs(view)
+    const args = { product_id: 'p1', folder: 'plans', slug: 's', max_chars: 40_000, offset: 12_000, heading: 'Design' }
+    const r = await capped.execute('get_product_doc', args, sig())
+    expect(r).toMatchObject({ ok: true })
+    expect(calls).toEqual([{ name: 'get_product_doc', args: { product_id: 'p1', folder: 'plans', slug: 's', max_chars: 12_000, offset: 12_000, heading: 'Design' } }])
+  })
+
+  it('leaves max_chars at or below the cap, and calls without max_chars, untouched', async () => {
+    const calls: Array<{ name: string; args: Record<string, unknown> }> = []
+    const { view } = fakeView(['get_product_doc'], calls)
+    const capped = capDocArgs(view)
+    await capped.execute('get_product_doc', { product_id: 'p1', max_chars: DOC_MAX_CHARS }, sig())
+    await capped.execute('get_product_doc', { product_id: 'p1', max_chars: 8_000 }, sig())
+    await capped.execute('get_product_doc', { product_id: 'p1' }, sig())
+    expect(calls).toEqual([
+      { name: 'get_product_doc', args: { product_id: 'p1', max_chars: DOC_MAX_CHARS } },
+      { name: 'get_product_doc', args: { product_id: 'p1', max_chars: 8_000 } },
+      { name: 'get_product_doc', args: { product_id: 'p1' } },
+    ])
+  })
+
+  it('does not touch other tools that have their own max_chars field', async () => {
+    const calls: Array<{ name: string; args: Record<string, unknown> }> = []
+    const { view } = fakeView(['search_product_docs'], calls)
+    const capped = capDocArgs(view)
+    await capped.execute('search_product_docs', { query: 'model comparison', max_chars: 40_000 }, sig())
+    expect(calls).toEqual([{ name: 'search_product_docs', args: { query: 'model comparison', max_chars: 40_000 } }])
+  })
+
+  it('ignores a non-numeric max_chars', async () => {
+    const calls: Array<{ name: string; args: Record<string, unknown> }> = []
+    const { view } = fakeView(['get_product_doc'], calls)
+    const capped = capDocArgs(view)
+    await capped.execute('get_product_doc', { product_id: 'p1', max_chars: '40000' }, sig())
+    expect(calls).toEqual([{ name: 'get_product_doc', args: { product_id: 'p1', max_chars: '40000' } }])
+  })
+
+  it('keeps the snapshot reference (same hash) and passes toOpenAiTools and close through', async () => {
+    const calls: Array<{ name: string; args: Record<string, unknown> }> = []
+    const { view, closed } = fakeView(['get_product_doc', 'search_product_docs'], calls)
+    const capped = capDocArgs(view)
+    expect(capped.snapshot).toBe(view.snapshot)
+    expect(capped.toOpenAiTools()).toEqual(view.toOpenAiTools())
+    await capped.close()
+    expect(closed()).toBe(true)
+  })
+})
