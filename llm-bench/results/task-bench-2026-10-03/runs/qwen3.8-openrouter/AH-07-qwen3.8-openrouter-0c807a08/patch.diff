index 0000000..64e61ce
--- /dev/null
+++ b/src/worker/doc-tools.ts
@@ -0,0 +1,31 @@
+import type { ToolRegistry, ToolExecResult } from '../types.js'
+
+/**
+ * Max_chars cap for get_product_doc calls through the worker's doc-tools view (ISS-1).
+ *
+ * The MCP allows max_chars up to 40 000, but above ±15 400 characters the answer JSON
+ * crosses TOOL_OUTPUT_LIMIT (16 384 bytes) and the registry cuts the tail — losing the
+ * `truncated` and `next_offset` fields the model needs to page through the doc.
+ * 12 000 is the MCP default, and even the largest doc yields at most 12.9 KB with it.
+ */
+export const DOC_MAX_CHARS = 12_000
+
+/**
+ * Wraps a ToolRegistry so get_product_doc calls asking for more than DOC_MAX_CHARS
+ * characters are lowered to it; every other tool and argument passes through unchanged.
+ * Snapshot, toOpenAiTools and close are passed through untouched, so the model's view
+ * of the schema (and the snapshot hash) stays the same.
+ */
+export function capDocArgs(view: ToolRegistry): ToolRegistry {
+  return {
+    snapshot: view.snapshot,
+    toOpenAiTools: () => view.toOpenAiTools(),
+    async execute(name, args, signal): Promise<ToolExecResult> {
+      if (name === 'get_product_doc' && typeof args.max_chars === 'number' && args.max_chars > DOC_MAX_CHARS) {
+        return view.execute(name, { ...args, max_chars: DOC_MAX_CHARS }, signal)
+      }
+      return view.execute(name, args, signal)
+    },
+    close: () => view.close(),
+  }
+}
