+import { Ajv } from 'ajv'
+import type { AnyValidateFunction } from 'ajv/dist/core.js'
+import type { ToolCall, ToolSnapshot } from '../types.js'
+
+// Ajv (default) validates draft-07, which is what MCP SDK 1.29 emits:
+// registerTool → toJsonSchemaCompat without a target → mapMiniTarget ⇒ 'draft-7'
+// (server/zod-json-schema-compat.js:9-16), so every inputSchema carries
+// `$schema: http://json-schema.org/draft-07/schema#`. Ajv2020 rejects that
+// `$schema` ("no schema with key or ref"); do not use it.
+export type PolicyDecision =
+  | { ok: true; name: string; args: Record<string, unknown> }
+  | { ok: false; errorCode: 'UNKNOWN_TOOL' | 'MALFORMED_ARGS' | 'SCHEMA_MISMATCH'; message: string }
+
+/**
+ * Strips `$schema` from a copy of the schema before compiling, so a later
+ * SDK bump to 2020-12 does not break the draft-07 validator immediately.
+ */
+function stripSchemaKey(schema: Record<string, unknown>): Record<string, unknown> {
+  const copy = { ...schema }
+  delete copy.$schema
+  return copy
+}
+
+export function createPolicy(snapshot: ToolSnapshot): { check(call: ToolCall): PolicyDecision } {
+  const ajv = new Ajv({ strict: false, allErrors: false })
+  const validators = new Map<string, AnyValidateFunction>()
+  const hasRequired = new Map<string, boolean>()
+  for (const entry of snapshot.entries) {
+    validators.set(entry.name, ajv.compile(stripSchemaKey(entry.inputSchema)))
+    const required = entry.inputSchema.required
+    hasRequired.set(entry.name, Array.isArray(required) && required.length > 0)
+  }
+
+  function check(call: ToolCall): PolicyDecision {
+    const validate = validators.get(call.name)
+    if (!validate) return { ok: false, errorCode: 'UNKNOWN_TOOL', message: `tool not in snapshot: ${call.name}` }
+
+    let args: unknown
+    if (call.arguments === '') {
+      // An empty arguments string means "no arguments" per the OpenAI contract.
+      // It is only acceptable when the schema demands nothing.
+      if (hasRequired.get(call.name)) {
+        return { ok: false, errorCode: 'MALFORMED_ARGS', message: `empty arguments for tool ${call.name} whose schema has required properties` }
+      }
+      args = {}
+    } else {
+      try {
+        args = JSON.parse(call.arguments)
+      } catch {
+        return { ok: false, errorCode: 'MALFORMED_ARGS', message: `arguments are not valid JSON: ${call.arguments}` }
+      }
+      if (typeof args !== 'object' || args === null || Array.isArray(args)) {
+        return { ok: false, errorCode: 'MALFORMED_ARGS', message: 'arguments are not a JSON object' }
+      }
+    }
+
+    if (!validate(args)) {
+      return { ok: false, errorCode: 'SCHEMA_MISMATCH', message: ajv.errorsText(validate.errors) }
+    }
+    return { ok: true, name: call.name, args: args as Record<string, unknown> }
+  }
+
+  return { check }
+}
