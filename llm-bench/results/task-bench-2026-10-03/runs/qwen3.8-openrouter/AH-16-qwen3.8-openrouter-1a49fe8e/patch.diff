+/**
+ * Canonical form of a repo URL for recipe matching: trimmed, host lowercased,
+ * a trailing '/' and a trailing '.git' removed. The path case is kept.
+ */
+export function normalizeRepoUrl(url: string): string {
+  let u = url.trim()
+  const m = u.match(/^(https?:\/\/)([^/]+)(.*)$/i)
+  if (m) u = m[1] + m[2].toLowerCase() + m[3]
+  while (u.endsWith('/')) u = u.slice(0, -1)
+  if (u.toLowerCase().endsWith('.git')) u = u.slice(0, -4)
+  return u
+}
+
+/** The recipe for `repoUrl`, matching exactly after `normalizeRepoUrl`; undefined when none. */
+export function findRecipe(task: TaskConfig, repoUrl: string): Recipe | undefined {
+  const wanted = normalizeRepoUrl(repoUrl)
+  return task.recipes.find((r) => normalizeRepoUrl(r.repoUrl) === wanted)
+}
