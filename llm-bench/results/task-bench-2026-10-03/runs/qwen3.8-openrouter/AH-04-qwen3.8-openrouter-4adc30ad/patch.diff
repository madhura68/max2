+
+  it('leaves the text unchanged without a key or for a key shorter than 8 characters', () => {
+    const text = 'some text'
+    expect(maskKey(text, undefined)).toBe(text)
+    expect(maskKey(text, '')).toBe(text)
+    expect(maskKey(`has ${'seven7'}`, 'seven7')).toBe(`has ${'seven7'}`)
+    expect(maskKey(`has ${'seven'}`, 'seven')).toBe(`has ${'seven'}`)
+  })
+})
