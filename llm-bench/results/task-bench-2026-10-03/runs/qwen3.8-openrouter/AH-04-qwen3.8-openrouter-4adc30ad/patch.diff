+// 40 characters, per the plan: long enough that a 200-char excerpt cut across it would leak a 6-char fragment.
+const DUMMY_KEY = 'sk-dummy-0123456789abcdef0123456789abcde'
+const keyFragments = (key: string, min = 6) => {
+  const parts: string[] = []
+  for (let len = min; len <= key.length; len++) for (let i = 0; i + len <= key.length; i++) parts.push(key.slice(i, i + len))
+  return parts
+}
+
+describe('key masking in error messages', () => {
+  it('masks the key in a 401 whose body echoes it', async () => {
+    fake = await startFakeModelServer([{ status: 401, body: { error: { message: `invalid API key: ${DUMMY_KEY}` } } }])
+    const c = createModelClient({ baseUrl: fake.baseUrl, name: 'm', apiKey: DUMMY_KEY })
+    const err = (await c.complete(msgs, opts()).catch((e: unknown) => e)) as Error
+    expect(err).toBeInstanceOf(ModelError)
+    expect(err.message).toContain('<redacted>')
+    expect(err.message).not.toContain(DUMMY_KEY)
+  })
+
+  it.each([
+    ['a 401 whose body has 190 characters before the key', { status: 401, body: `${'x'.repeat(190)}${DUMMY_KEY} post` }],
+    ['a 401 with a non-JSON body containing the key', { status: 401, body: `${'y'.repeat(190)}${DUMMY_KEY} tail` }],
+    ['a 200 with an error object containing the key', { body: { error: { message: `${'z'.repeat(190)}${DUMMY_KEY}` } } }],
+    ['a 200 without choices whose body contains the key', { body: { id: 'x', blob: `${'w'.repeat(190)}${DUMMY_KEY}` } }],
+    ['a 200 whose body is not JSON and contains the key', { body: `${'v'.repeat(190)}${DUMMY_KEY}` }],
+  ])('leaks no 6-char fragment of the key for %s', async (_label, turn) => {
+    fake = await startFakeModelServer([turn])
+    const c = createModelClient({ baseUrl: fake.baseUrl, name: 'm', apiKey: DUMMY_KEY })
+    const err = (await c.complete(msgs, opts()).catch((e: unknown) => e)) as Error
+    expect(err).toBeInstanceOf(ModelError)
+    for (const fragment of keyFragments(DUMMY_KEY)) expect(err.message).not.toContain(fragment)
+  })
+})
