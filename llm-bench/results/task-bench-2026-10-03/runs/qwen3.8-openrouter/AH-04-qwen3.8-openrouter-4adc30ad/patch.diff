+describe('maskKey', () => {
+  it('replaces every occurrence of the key with <redacted>', () => {
+    expect(maskKey(`a ${'sk-0123456789ab'} b ${'sk-0123456789ab'} c`, 'sk-0123456789ab')).toBe('a <redacted> b <redacted> c')
