 // M21 (spec §2): sprint-batch auto-deploy — eigen module zodat update-job-status
 // de helper kan importeren én mocken.
+import { prisma } from '../../prisma.js'
+import { checkDeployEligibility, maybeEnqueueDeployJob } from './deploy-job.js'
+import { executeEffects } from '../../flow/effects.js'
+import { getPullRequestState } from '../../git/pr.js'
+import { triggerPush } from '../push-trigger.js'
 
 // Genormaliseerde repo-bucket-key. null/undefined/lege/whitespace-only repo_url
 // EN de expliciete product-repo-url (met of zonder .git-suffix) = het
@@ -18,3 +23,151 @@ export function repoBucketKey(
   if (r === norm(productRepoUrl)) return null
   return r
 }
+
+// M21 Taak 3: niveau-triggered auto-deploy voor sprint-batch (spec §2).
+//
+// LEVEL-triggered (zoals de STORY-auto-merge in update-job-status, E2E-bevinding
+// #7): de level-check is SprintRun.status === 'DONE'. Wordt na elke
+// sprint-finalisatie aangeroepen; als de run nog niet DONE is, gebeurt er
+// niks. Dubbel vuren is veilig — de DEPLOY-enqueue is DB-hard gededupt op
+// orchestration_key en een tweede auto-merge-enable op een al-geschedulede PR
+// is een no-op.
+//
+// Pad: level-check → product-repo-batch-PR via repoBucketKey (nooit een
+// cross-repo-sha meenemen) → head-sha zelf-resolvend (job.head_sha, anders
+// fail-safe getPullRequestState; beide onbereikbaar → skip) →
+// checkDeployEligibility (not_configured: stil stoppen; blocked: web-push) →
+// ENABLE_AUTO_MERGE-effect (niet-ok: web-push + GÉÉN enqueue) →
+// maybeEnqueueDeployJob met tweede-check-observability (.catch én
+// not_configured/blocked ná een ok-enable → web-push).
+export async function maybeAutoDeploySprintBatchPr(opts: {
+  jobId: string
+  userId: string
+  productId: string
+  sprintRunId: string
+}): Promise<void> {
+  const { jobId, userId, productId, sprintRunId } = opts
+
+  // (1) Level-check: alleen als de SprintRun echt DONE is.
+  const run = await prisma.sprintRun.findUnique({
+    where: { id: sprintRunId },
+    select: { status: true },
+  })
+  if (!run || run.status !== 'DONE') return
+
+  const product = await prisma.product.findUnique({
+    where: { id: productId },
+    select: { repo_url: true },
+  })
+
+  // (2) Product-repo-batch-PR zoeken binnen de SprintRun. Per repo-bucket:
+  // twee jobs zitten in dezelfde bucket als repoBucketKey gelijk is; het
+  // product-repo is bucket null. Alleen de EERSTE PR van het product-repo
+  // bucket wordt gebruikt — de cross-repo-sha van een andere bucket mag nooit
+  // meelekken.
+  const prJobs = await prisma.claudeJob.findMany({
+    where: { sprint_run_id: sprintRunId, pr_url: { not: null } },
+    orderBy: { created_at: 'asc' },
+    select: {
+      pr_url: true,
+      head_sha: true,
+      task: { select: { repo_url: true } },
+    },
+  })
+  const productPrJob = prJobs.find(
+    (j) => repoBucketKey(j.task?.repo_url, product?.repo_url) === null,
+  )
+  if (!productPrJob?.pr_url) {
+    console.warn(
+      `[maybeAutoDeploySprintBatchPr] geen product-repo-PR voor sprint-run ${sprintRunId}; skip`,
+    )
+    return
+  }
+  const prUrl = productPrJob.pr_url
+
+  // (3) Head-sha zelf-resolvend: eerst de head_sha van de PR-job zelf; anders
+  // fail-safe via getPullRequestState. Beide leeg → skip (geen auto-merge op
+  // een onbekende head).
+  let headSha = productPrJob.head_sha
+  if (!headSha) {
+    const state = await getPullRequestState({ prUrl })
+    if ('error' in state) {
+      console.warn(
+        `[maybeAutoDeploySprintBatchPr] head-sha onbereikbaar voor ${prUrl}: ${state.error}; skip`,
+      )
+      return
+    }
+    headSha = state.headSha ?? undefined
+  }
+  if (!headSha) {
+    console.warn(`[maybeAutoDeploySprintBatchPr] geen head-sha voor ${prUrl}; skip`)
+    return
+  }
+
+  // Web-push helper voor de observability-paden (preflight-blocked, enable-fail,
+  // enqueue-fail/tweede-check).
+  const notify = (title: string, body: string) => {
+    void triggerPush(userId, {
+      title,
+      body: body.slice(0, 120),
+      url: '/jobs',
+      tag: `sprint-batch-auto-deploy-${jobId}`,
+    })
+  }
+
+  // (4a) Preflight: niet-configured stopt stil (geen auto-deploy opgezet —
+  // geen push nodig); blocked meldt wél (onopgeloste FAILED DEPLOY).
+  const eligibility = await checkDeployEligibility(productId)
+  if (eligibility === 'not_configured') return
+  if (eligibility === 'blocked') {
+    notify(
+      'Sprint-batch auto-deploy geblokkeerd',
+      `Onopgeloste FAILED DEPLOY-job voor product ${productId}; auto-deploy van ${prUrl} niet ingezet.`,
+    )
+    return
+  }
+
+  // (4c) Auto-merge aanzetten met head-sha-guard. Niet-ok → web-push en géén
+  // enqueue (een DEPLOY-job mag nooit vóór de auto-merge in de wachtrij).
+  const outcomes = await executeEffects([
+    { type: 'ENABLE_AUTO_MERGE', prUrl, expectedHeadSha: headSha },
+  ])
+  const enable = outcomes.find((o) => o.effect === 'ENABLE_AUTO_MERGE')
+  if (!enable?.ok) {
+    const detail =
+      enable && !enable.ok ? `${enable.reason}: ${enable.stderr.slice(0, 120)}` : 'geen uitkomst'
+    console.warn(`[maybeAutoDeploySprintBatchPr] ENABLE_AUTO_MERGE niet ok voor ${prUrl}: ${detail}`)
+    notify(
+      'Sprint-batch auto-deploy mislukt',
+      `Auto-merge aanzetten op ${prUrl} faalde (${detail}); geen DEPLOY-job ingepland.`,
+    )
+    return
+  }
+
+  // (4d) Enqueue + tweede-check-observability: zowel een enqueue-fout als een
+  // not_configured/blocked-uitkomst (config/blokkade veranderde tussendoor)
+  // mogen niet onzichtbaar zijn — push naast de log.
+  const outcome = await maybeEnqueueDeployJob({
+    parentJobId: jobId,
+    userId,
+    productId,
+    prUrl,
+    headSha,
+  }).catch((err) => {
+    console.error('[sprint-batch-auto-deploy] maybeEnqueueDeployJob failed:', err)
+    notify(
+      'Sprint-batch auto-deploy enqueue mislukt',
+      (err instanceof Error ? err.message : String(err)),
+    )
+    return null
+  })
+  if (outcome === 'not_configured' || outcome === 'blocked') {
+    console.warn(
+      `[maybeAutoDeploySprintBatchPr] tweede-check: enqueue ${outcome} voor ${prUrl} (enable was ok)`,
+    )
+    notify(
+      'Sprint-batch auto-deploy enqueue geskipt',
+      `DEPLOY-enqueue ${outcome} voor ${prUrl} ondanks ok auto-merge (config/blokkade veranderde tussendoor).`,
+    )
+  }
+}
