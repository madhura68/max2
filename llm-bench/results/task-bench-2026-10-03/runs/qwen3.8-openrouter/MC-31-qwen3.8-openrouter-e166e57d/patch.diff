+// M21 Taak 3: maybeAutoDeploySprintBatchPr (src/lib/dispatch/sprint-batch-deploy.ts).
+// Niveau-triggered auto-deploy voor sprint-batch: level-check (SprintRun DONE) →
+// product-repo-batch-PR via repoBucketKey → head-sha zelf-resolvend (fail-safe
+// getPullRequestState, nooit een cross-repo-sha) → preflight-eligibility →
+// ENABLE_AUTO_MERGE-effect → maybeEnqueueDeployJob met tweede-check-observability.
+//
+// vi.hoisted voor álle mock-fns; module-aliassen (vi.mock) ná de hoisted mocks.
+
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const mocks = vi.hoisted(() => ({
+  prisma: {
+    sprintRun: { findUnique: vi.fn() },
+    product: { findUnique: vi.fn() },
+    claudeJob: { findMany: vi.fn() },
+  },
+  checkDeployEligibility: vi.fn(),
+  maybeEnqueueDeployJob: vi.fn(),
+  executeEffects: vi.fn(),
+  getPullRequestState: vi.fn(),
+  triggerPush: vi.fn(),
+}))
+
+vi.mock('../src/prisma.js', () => ({ prisma: mocks.prisma }))
+vi.mock('../src/lib/dispatch/deploy-job.js', () => ({
+  checkDeployEligibility: mocks.checkDeployEligibility,
+  maybeEnqueueDeployJob: mocks.maybeEnqueueDeployJob,
+}))
+vi.mock('../src/flow/effects.js', () => ({ executeEffects: mocks.executeEffects }))
+vi.mock('../src/git/pr.js', () => ({ getPullRequestState: mocks.getPullRequestState }))
+vi.mock('../src/lib/push-trigger.js', () => ({ triggerPush: mocks.triggerPush }))
+
+import { maybeAutoDeploySprintBatchPr } from '../src/lib/dispatch/sprint-batch-deploy.js'
+
+const opts = {
+  jobId: 'job-final',
+  userId: 'user-1',
+  productId: 'prod-1',
+  sprintRunId: 'sr-1',
+}
+
+const PRODUCT_REPO = 'https://git.jp-visser.nl/janpeter/Scrum4Me'
+const PRODUCT_PR = 'https://git.jp-visser.nl/janpeter/Scrum4Me/pulls/91'
+const CROSS_REPO_PR = 'https://git.jp-visser.nl/janpeter/OtherRepo/pulls/5'
+
+// Standaard: SprintRun DONE, product bekend, géén PR-jobs. Per test worden de
+// findUnique-mocks (sprintRun + product) vervangen door een implementation die
+// per model de juiste rijen teruggeeft.
+function baseMocksWith(sprintRunStatus: string, prJobs: unknown[] = []) {
+  mocks.prisma.sprintRun.findUnique.mockImplementation(async (args: {
+    where: { id: string }
+    select?: { status?: boolean; repo_url?: boolean }
+  }) => {
+    if (args.select?.repo_url) {
+      return { id: 'prod-1', repo_url: PRODUCT_REPO }
+    }
+    return { id: 'sr-1', status: sprintRunStatus }
+  })
+  mocks.prisma.product.findUnique.mockImplementation(async () => ({
+    id: 'prod-1',
+    repo_url: PRODUCT_REPO,
+  }))
+  mocks.prisma.claudeJob.findMany.mockResolvedValue(prJobs)
+}
+
+function expectWebPush() {
+  expect(mocks.triggerPush).toHaveBeenCalledWith(
+    'user-1',
+    expect.objectContaining({ title: expect.any(String) }),
+  )
+}
+
+describe('maybeAutoDeploySprintBatchPr (M21 Taak 3)', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    // Defaults die per test overboord mogen:
+    mocks.checkDeployEligibility.mockResolvedValue('eligible')
+    mocks.executeEffects.mockResolvedValue([{ effect: 'ENABLE_AUTO_MERGE', ok: true }])
+    mocks.maybeEnqueueDeployJob.mockResolvedValue('enqueued')
+    mocks.getPullRequestState.mockResolvedValue({ error: 'boom' })
+    mocks.triggerPush.mockResolvedValue(undefined)
+  })
+
+  it('happy path: eligible → ENABLE_AUTO_MERGE(product-PR, product-sha) → enqueue', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: 'abc123',
+        task: { repo_url: null },
+      },
+    ])
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.executeEffects).toHaveBeenCalledTimes(1)
+    expect(mocks.executeEffects).toHaveBeenCalledWith([
+      { type: 'ENABLE_AUTO_MERGE', prUrl: PRODUCT_PR, expectedHeadSha: 'abc123' },
+    ])
+    expect(mocks.maybeEnqueueDeployJob).toHaveBeenCalledWith({
+      parentJobId: 'job-final',
+      userId: 'user-1',
+      productId: 'prod-1',
+      prUrl: PRODUCT_PR,
+      headSha: 'abc123',
+    })
+    expect(mocks.triggerPush).not.toHaveBeenCalled()
+  })
+
+  it('level-trigger: SprintRun ≠ DONE → direct return (géén PR-resolve/enable/enqueue)', async () => {
+    baseMocksWith('RUNNING')
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.prisma.claudeJob.findMany).not.toHaveBeenCalled()
+    expect(mocks.checkDeployEligibility).not.toHaveBeenCalled()
+    expect(mocks.executeEffects).not.toHaveBeenCalled()
+    expect(mocks.maybeEnqueueDeployJob).not.toHaveBeenCalled()
+    expect(mocks.triggerPush).not.toHaveBeenCalled()
+  })
+
+  it('not_configured: preflight stopt stil — géén enable, géén enqueue, géén push', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: 'abc123',
+        task: { repo_url: null },
+      },
+    ])
+    mocks.checkDeployEligibility.mockResolvedValue('not_configured')
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.executeEffects).not.toHaveBeenCalled()
+    expect(mocks.maybeEnqueueDeployJob).not.toHaveBeenCalled()
+    expect(mocks.triggerPush).not.toHaveBeenCalled()
+  })
+
+  it('blocked: preflight-fail → web-push, géén enable en géén enqueue', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: 'abc123',
+        task: { repo_url: null },
+      },
+    ])
+    mocks.checkDeployEligibility.mockResolvedValue('blocked')
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.executeEffects).not.toHaveBeenCalled()
+    expect(mocks.maybeEnqueueDeployJob).not.toHaveBeenCalled()
+    expectWebPush()
+  })
+
+  it('enable-fail: ENABLE_AUTO_MERGE niet ok → web-push + GÉÉN enqueue', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: 'abc123',
+        task: { repo_url: null },
+      },
+    ])
+    mocks.executeEffects.mockResolvedValue([
+      { effect: 'ENABLE_AUTO_MERGE', ok: false, reason: 'AUTO_MERGE_NOT_ALLOWED', stderr: 'denied' },
+    ])
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.maybeEnqueueDeployJob).not.toHaveBeenCalled()
+    expectWebPush()
+  })
+
+  it('tweede-check-race: enqueue blocked ná ok-enable → web-push (observability)', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: 'abc123',
+        task: { repo_url: null },
+      },
+    ])
+    let resolveEnqueue!: (v: string) => void
+    const enqueueResult = new Promise<string>((resolve) => {
+      resolveEnqueue = resolve
+    })
+    mocks.maybeEnqueueDeployJob.mockReturnValue(enqueueResult)
+
+    const run = maybeAutoDeploySprintBatchPr(opts)
+    // Laag even af om de .catch-observability te laten registreren.
+    await new Promise((r) => setTimeout(r, 10))
+    resolveEnqueue('blocked')
+    await run
+
+    // De enable WÉL ok geweest (enqueued werd wel geprobeerd); de tweede check
+    // (not_configured/blocked) moet een web-push geven.
+    expect(mocks.executeEffects).toHaveBeenCalledTimes(1)
+    expectWebPush()
+  })
+
+  it('repo-bucket: cross-repo-PR eerst aangemaakt → product-repo-PR gekozen, geen cross-repo-lek', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: CROSS_REPO_PR,
+        head_sha: 'cross-sha',
+        task: { repo_url: 'https://git.jp-visser.nl/janpeter/OtherRepo' },
+      },
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: 'prod-sha',
+        task: { repo_url: null },
+      },
+    ])
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.executeEffects).toHaveBeenCalledWith([
+      { type: 'ENABLE_AUTO_MERGE', prUrl: PRODUCT_PR, expectedHeadSha: 'prod-sha' },
+    ])
+    expect(mocks.maybeEnqueueDeployJob).toHaveBeenCalledWith(
+      expect.objectContaining({ prUrl: PRODUCT_PR, headSha: 'prod-sha' }),
+    )
+    // De fail-safe hoeft niet aan te slaan: de product-PR job draagt z'n head_sha.
+    expect(mocks.getPullRequestState).not.toHaveBeenCalled()
+    expect(mocks.triggerPush).not.toHaveBeenCalled()
+  })
+
+  it('geen product-repo-PR in de SprintRun → skip (géén preflight/enable/enqueue/push)', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: CROSS_REPO_PR,
+        head_sha: 'cross-sha',
+        task: { repo_url: 'https://git.jp-visser.nl/janpeter/OtherRepo' },
+      },
+    ])
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.checkDeployEligibility).not.toHaveBeenCalled()
+    expect(mocks.executeEffects).not.toHaveBeenCalled()
+    expect(mocks.maybeEnqueueDeployJob).not.toHaveBeenCalled()
+    expect(mocks.triggerPush).not.toHaveBeenCalled()
+  })
+
+  it('head-sha fail-safe null én getPullRequestState onbereikbaar → skip', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: null,
+        task: { repo_url: null },
+      },
+    ])
+    mocks.getPullRequestState.mockResolvedValue({ error: 'Forgejo unreachable' })
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.getPullRequestState).toHaveBeenCalledWith({ prUrl: PRODUCT_PR })
+    expect(mocks.checkDeployEligibility).not.toHaveBeenCalled()
+    expect(mocks.executeEffects).not.toHaveBeenCalled()
+    expect(mocks.maybeEnqueueDeployJob).not.toHaveBeenCalled()
+    expect(mocks.triggerPush).not.toHaveBeenCalled()
+  })
+
+  it('head-sha fail-safe null → getPullRequestState levert head → gebruikt die', async () => {
+    baseMocksWith('DONE', [
+      {
+        pr_url: PRODUCT_PR,
+        head_sha: null,
+        task: { repo_url: null },
+      },
+    ])
+    mocks.getPullRequestState.mockResolvedValue({
+      prUrl: PRODUCT_PR,
+      headSha: 'live-sha',
+      state: 'OPEN',
+    })
+
+    await maybeAutoDeploySprintBatchPr(opts)
+
+    expect(mocks.executeEffects).toHaveBeenCalledWith([
+      { type: 'ENABLE_AUTO_MERGE', prUrl: PRODUCT_PR, expectedHeadSha: 'live-sha' },
+    ])
+    expect(mocks.maybeEnqueueDeployJob).toHaveBeenCalledWith(
+      expect.objectContaining({ prUrl: PRODUCT_PR, headSha: 'live-sha' }),
+    )
+  })
+})
