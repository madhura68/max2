+import { workerMcpEnv, type WorkerConfig } from './config.js'
+
+/**
+ * Redactie van run-logs, dezelfde regels als de runner (scrum4me-docker `lib/log-redact.ts:9-58`, 52ded13;
+ * de regelbuffer voor streams uit `:60-88` is hier niet nodig). Gemaskeerd worden:
+ * - de volledige waarde van variabelen waarvan de naam matcht op `SECRET_NAME_RE`;
+ * - het wachtwoord uit elke URL-waarde, ruw én URL-gedecodeerd.
+ * De waarden in de redactieset zijn vanaf 8 tekens; de langste wordt eerst vervangen, door `REDACTED`.
+ */
+
+export const REDACTED = '***'
+
+const SECRET_NAME_RE = /(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|PRIVATE_KEY|_KEY$|DSN|CREDENTIAL)/i
+
+const MIN_SECRET_LENGTH = 8
+
+// De userinfo tussen `://` en de volgende `@`; `host:port` zonder `@` is geen userinfo.
+const USERINFO = /:\/\/([^@\/\s]*)@/
+
+/** Het wachtwoord uit een URL-waarde: de ruwe en de gedecodeerde vorm; lege vormen vallen weg. */
+function urlPassword(value: string): string[] {
+  const userinfo = value.match(USERINFO)?.[1]
+  const raw = userinfo !== undefined ? userinfo.slice(userinfo.lastIndexOf(':') + 1) : undefined
+  if (!raw) return []
+  const decoded = safeDecode(raw)
+  return decoded === raw ? [raw] : [raw, decoded]
+}
+
+function safeDecode(s: string): string {
+  try {
+    return decodeURIComponent(s)
+  } catch {
+    return s
+  }
+}
+
+/**
+ * Alle kandidaten met hun bron: de waarde van een variabele met een geheim-achtige naam, en het
+ * wachtwoord uit elke URL-waarde (ruw en gedecodeerd). Zonder lengtefilter; lege waarden vallen weg.
+ */
+export function collectSecretEntries(...envs: Array<Record<string, string | undefined>>): { name: string; value: string }[] {
+  const entries: { name: string; value: string }[] = []
+  for (const env of envs) {
+    for (const [name, value] of Object.entries(env)) {
+      if (value === undefined || value === '') continue
+      if (SECRET_NAME_RE.test(name)) entries.push({ name, value })
+      for (const pw of urlPassword(value)) entries.push({ name: `${name} (url-wachtwoord)`, value: pw })
+    }
+  }
+  return entries
+}
+
+/** De redactieset: de waarden uit collectSecretEntries vanaf 8 tekens, uniek, langste eerst (= de runnerregel). */
+export function collectSecretValues(...envs: Array<Record<string, string | undefined>>): string[] {
+  const seen = new Set<string>()
+  const out: string[] = []
+  for (const { value } of collectSecretEntries(...envs)) {
+    if (value.length < MIN_SECRET_LENGTH || seen.has(value)) continue
+    seen.add(value)
+    out.push(value)
+  }
+  return out.sort((a, b) => b.length - a.length)
+}
+
+/** Vervangt elke secret (langste eerst) door `REDACTED`; dezelfde regel als de runner. */
+export function redactText(text: string, secrets: readonly string[]): string {
+  let out = text
+  for (const secret of [...secrets].sort((a, b) => b.length - a.length)) {
+    if (secret === '' || !out.includes(secret)) continue
+    out = out.split(secret).join(REDACTED)
+  }
+  return out
+}
+
+/** Redigeert elke string in een JSON-waarde (objecten en arrays recursief); andere waarden blijven gelijk. */
+export function redactDeep<T>(value: T, secrets: readonly string[]): T {
+  if (typeof value === 'string') return redactText(value, secrets) as T
+  if (Array.isArray(value)) return value.map((v) => redactDeep(v, secrets)) as T
+  if (value !== null && typeof value === 'object' && !Array.isArray(value)) {
+    const out: Record<string, unknown> = {}
+    for (const [k, v] of Object.entries(value as Record<string, unknown>)) out[k] = redactDeep(v, secrets)
+    return out as T
+  }
+  return value
+}
+
+/**
+ * De vier redactiebronnen van de worker: `process.env`, de opgeloste MCP-omgeving, `model.apiKey` en
+ * het wachtwoord uit `model.baseUrl`. De worker (Taak 5) en de controle (Taak 7) gebruiken allebei deze functie.
+ */
+export function workerSecretSources(
+  config: WorkerConfig,
+  processEnv: NodeJS.ProcessEnv = process.env,
+): Array<Record<string, string | undefined>> {
+  return [processEnv, workerMcpEnv(config, processEnv), { MODEL_API_KEY: config.model.apiKey, MODEL_BASE_URL: config.model.baseUrl }]
+}
