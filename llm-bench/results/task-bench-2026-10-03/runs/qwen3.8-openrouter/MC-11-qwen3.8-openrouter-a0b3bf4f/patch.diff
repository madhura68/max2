+++ b/__tests__/queue-archive.test.ts
@@ -0,0 +1,186 @@
+// M32 spec 4.4 — queue_archive/queue_unarchive: subtree (recursieve
+// in_reply_to-keten), terminaal-check (alleen bij archiveren), per-rij
+// idempotentie via de where-clause, géén NOTIFY. $transaction-mock die de
+// callback met een tx-object aanroept, zelfde patroon als queue-done.test.ts.
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const updateMany = vi.hoisted(() => vi.fn())
+const queryRaw = vi.hoisted(() => vi.fn())
+const executeRaw = vi.hoisted(() => vi.fn())
+const txMock = vi.hoisted(() => ({
+  $queryRaw: queryRaw,
+  $executeRaw: executeRaw,
+  agentMessage: { updateMany },
+}))
+
+vi.mock('../src/prisma.js', () => ({
+  prisma: { $transaction: vi.fn(async (fn: (tx: unknown) => Promise<unknown>) => fn(txMock)) },
+}))
+vi.mock('../src/auth.js', async (importOriginal) => {
+  const original = await importOriginal<typeof import('../src/auth.js')>()
+  return { ...original, requireWriteAccess: vi.fn() }
+})
+
+import { requireWriteAccess } from '../src/auth.js'
+import { registerQueueArchiveTools } from '../src/tools/queue-archive.js'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import type { AnyMock } from './helpers/mocks.js'
+
+const mockAuth = requireWriteAccess as AnyMock
+const qraw = queryRaw as AnyMock
+const xraw = executeRaw as AnyMock
+const updateManyCall = updateMany as AnyMock
+
+type ToolResult = { isError?: boolean; content: { text: string }[] }
+
+function makeServers() {
+  const handlers: Record<string, (args: Record<string, unknown>) => Promise<unknown>> = {}
+  const server = {
+    registerTool: vi.fn((name: string, _meta: unknown, fn: (args: Record<string, unknown>) => Promise<unknown>) => {
+      handlers[name] = fn
+    }),
+    call: (name: string, args: Record<string, unknown>) => Promise.resolve(handlers[name](args)) as Promise<ToolResult>,
+  }
+  registerQueueArchiveTools(server as unknown as McpServer)
+  return server
+}
+
+const ROOT_ID = 'aaaaaaaa-0000-4000-8000-0000000000a0'
+const CHILD_ID = 'aaaaaaaa-0000-4000-8000-0000000000a1'
+
+function row(id: string, overrides: Partial<Record<string, unknown>> = {}) {
+  return {
+    id,
+    type: 'info',
+    from_server: 'max2',
+    from_model: 'codex',
+    to_server: 'mac',
+    to_model: 'claude',
+    body: 'x',
+    meta: {},
+    source: 'cli',
+    status: 'done',
+    in_reply_to: null,
+    error: null,
+    claimed_by: null,
+    claimed_at: null,
+    started_at: null,
+    finished_at: new Date(),
+    created_at: new Date(),
+    archived_at: null,
+    ...overrides,
+  }
+}
+
+function subtreeRows(overrides: Partial<Record<string, unknown>> = {}) {
+  return [
+    row(ROOT_ID, overrides),
+    row(CHILD_ID, { in_reply_to: ROOT_ID, ...overrides }),
+  ]
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  mockAuth.mockResolvedValue({ userId: 'u', tokenId: 't', username: 'agent', isDemo: false })
+  qraw.mockResolvedValue([])
+  updateManyCall.mockResolvedValue({ count: 0 })
+})
+
+describe('queue_archive — validaties (M32 §4.4)', () => {
+  it('QUEUE_NOT_FOUND voor een onbekend id', async () => {
+    qraw.mockResolvedValue([])
+    const server = makeServers()
+    const result = await server.call('queue_archive', { message_id: ROOT_ID })
+    expect(result.isError).toBe(true)
+    expect(result.content[0].text).toContain('QUEUE_NOT_FOUND')
+    expect(updateManyCall).not.toHaveBeenCalled()
+  })
+
+  it('QUEUE_NOT_TERMINAL mét blokkerend rij-id + status; géén updateMany', async () => {
+    qraw.mockResolvedValue([
+      row(ROOT_ID, { status: 'done' }),
+      row(CHILD_ID, { in_reply_to: ROOT_ID, status: 'pending', finished_at: null }),
+    ])
+    const server = makeServers()
+    const result = await server.call('queue_archive', { message_id: ROOT_ID })
+    expect(result.isError).toBe(true)
+    expect(result.content[0].text).toContain('QUEUE_NOT_TERMINAL')
+    expect(result.content[0].text).toContain(CHILD_ID)
+    expect(result.content[0].text).toContain('pending')
+    expect(updateManyCall).not.toHaveBeenCalled()
+  })
+
+  it('lockt de subtree via WITH RECURSIVE + FOR UPDATE binnen de transactie', async () => {
+    qraw.mockResolvedValue(subtreeRows())
+    const server = makeServers()
+    await server.call('queue_archive', { message_id: ROOT_ID })
+    const sql = (qraw.mock.calls[0][0] as readonly string[]).join(' ')
+    expect(sql).toContain('WITH RECURSIVE')
+    expect(sql).toContain('FOR UPDATE')
+    expect(qraw.mock.calls[0].slice(1)).toEqual([ROOT_ID])
+    // géén NOTIFY: geen enkele $executeRaw-calls in deze tool
+    expect(xraw).not.toHaveBeenCalled()
+  })
+})
+
+describe('queue_archive — happy path', () => {
+  it('updateMany op de hele subtree, per-rij idempotent (archived_at: null) → { message_id, total, archived }', async () => {
+    qraw.mockResolvedValue(subtreeRows())
+    updateManyCall.mockResolvedValue({ count: 1 })
+    const server = makeServers()
+    const result = await server.call('queue_archive', { message_id: ROOT_ID })
+    expect(result.isError).toBeUndefined()
+    expect(updateManyCall).toHaveBeenCalledTimes(1)
+    const args = updateManyCall.mock.calls[0][0] as {
+      where: Record<string, unknown>
+      data: Record<string, unknown>
+    }
+    expect(args.where).toEqual({ id: { in: [ROOT_ID, CHILD_ID] }, archived_at: null })
+    expect(args.data).toEqual({ archived_at: expect.any(Date) })
+    const body = JSON.parse(result.content[0].text)
+    expect(body).toEqual({ message_id: ROOT_ID, total: 2, archived: 1 })
+  })
+})
+
+describe('queue_unarchive', () => {
+  it('updateMany { archived_at: { not: null } } → null; géén terminaal-check', async () => {
+    // Een niet-terminale rij in de subtree blokkeert unarchive niet.
+    qraw.mockResolvedValue([
+      row(ROOT_ID, { status: 'done' }),
+      row(CHILD_ID, { in_reply_to: ROOT_ID, status: 'pending', finished_at: null }),
+    ])
+    updateManyCall.mockResolvedValue({ count: 1 })
+    const server = makeServers()
+    const result = await server.call('queue_unarchive', { message_id: ROOT_ID })
+    expect(result.isError).toBeUndefined()
+    expect(updateManyCall).toHaveBeenCalledTimes(1)
+    const args = updateManyCall.mock.calls[0][0] as {
+      where: Record<string, unknown>
+      data: Record<string, unknown>
+    }
+    expect(args.where).toEqual({ id: { in: [ROOT_ID, CHILD_ID] }, archived_at: { not: null } })
+    expect(args.data).toEqual({ archived_at: null })
+    const body = JSON.parse(result.content[0].text)
+    expect(body).toEqual({ message_id: ROOT_ID, total: 2, unarchived: 1 })
+    expect(xraw).not.toHaveBeenCalled()
+  })
+
+  it('QUEUE_NOT_FOUND voor een onbekend id', async () => {
+    qraw.mockResolvedValue([])
+    const server = makeServers()
+    const result = await server.call('queue_unarchive', { message_id: ROOT_ID })
+    expect(result.isError).toBe(true)
+    expect(result.content[0].text).toContain('QUEUE_NOT_FOUND')
+    expect(updateManyCall).not.toHaveBeenCalled()
+  })
+})
+
+describe('registratie', () => {
+  it('registerQueueArchiveTools registreert exact queue_archive + queue_unarchive', () => {
+    const names: string[] = []
+    registerQueueArchiveTools({
+      registerTool: vi.fn((n: string) => names.push(n)),
+    } as unknown as McpServer)
+    expect([...names].sort()).toEqual(['queue_archive', 'queue_unarchive'])
+  })
+})
