diff --git a/src/tools/queue-archive.ts b/src/tools/queue-archive.ts
new file mode 100644
index 0000000..5a70b32
--- /dev/null
+++ b/src/tools/queue-archive.ts
@@ -0,0 +1,111 @@
+// M32 spec 4.4 — queue_archive / queue_unarchive.
+//
+// Semantiek identiek aan s4m-queue archiveSubtree/unarchiveSubtree:
+//   - subtree: het bericht plus alle (transitieve) replies via in_reply_to,
+//     opgehaald én verwerkt in één transactie
+//   - lockSubtree: WITH RECURSIVE ... FOR UPDATE over de keten, zodat een
+//     concurrente queue_done/queue_fail niet onder de check door kan
+//   - terminaal-check: alleen bij archiveren — elkeen van de subtree-rijen
+//     moet done/failed/cancelled zijn (QUEUE_TERMINAL_STATUSES, afgeleid uit
+//     @shared/queue-identity.js, niet overgetypt). Unarchive kent géén
+//     terminaal-check: een gearchiveerde keten kan altijd terug.
+//   - per-rij idempotentie: de where-clause (archived_at: null resp.
+//     { not: null }) laat al-archiveren/ongearchiveerde rijen gewoon overslaan
+//   - géén NOTIFY: archiveren is opslaghygiëne, geen queue-overgang —
+//     watchers/pollers hoeven er niet op te reageren.
+//
+// Agents mogen archiveren (opruim-automatisering); identiteit komt via de
+// bestaande S4M_SERVER/S4M_MODEL-regels, zoals bij alle queue-tools.
+import { z } from 'zod'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { Prisma } from '@prisma/client'
+import { prisma } from '../prisma.js'
+import { requireWriteAccess } from '../auth.js'
+import { toolError, toolJson, withToolErrors } from '../errors.js'
+import { QUEUE_TERMINAL_STATUSES } from '@shared/queue-identity.js'
+
+const inputSchema = z.object({
+  message_id: z.string().uuid(),
+})
+
+type SubtreeRow = { id: string; status: string }
+
+async function lockSubtree(tx: typeof prisma, messageId: string): Promise<SubtreeRow[]> {
+  return (await tx.$queryRaw(
+    Prisma.sql`WITH RECURSIVE subtree AS (
+      SELECT * FROM agent_message WHERE id = ${messageId}
+      UNION ALL
+      SELECT am.* FROM agent_message am JOIN subtree s ON am.in_reply_to = s.id
+    ) SELECT id, status FROM subtree FOR UPDATE`,
+  )) as SubtreeRow[]
+}
+
+export function registerQueueArchiveTools(server: McpServer): void {
+  server.registerTool(
+    'queue_archive',
+    {
+      title: 'Queue archive',
+      description:
+        'Archive a finished queue message and its whole reply subtree ' +
+        '(recursively via in_reply_to). Every row in the subtree must be terminal ' +
+        '(done/failed/cancelled); per-row idempotent — already-archived rows are ' +
+        'skipped. Archived rows are hidden from queue_list/queue_next by default. ' +
+        'Returns { message_id, total, archived }.',
+      inputSchema,
+      annotations: { readOnlyHint: false, idempotentHint: true },
+    },
+    async ({ message_id }) =>
+      withToolErrors(async () => {
+        await requireWriteAccess()
+        return prisma.$transaction(async (tx) => {
+          const rows = await lockSubtree(tx, message_id)
+          if (rows.length === 0) {
+            return toolError(`QUEUE_NOT_FOUND: message ${message_id} does not exist`)
+          }
+          const terminal = [...QUEUE_TERMINAL_STATUSES]
+          const blockers = rows.filter((row) => !terminal.includes(row.status))
+          if (blockers.length > 0) {
+            const first = blockers[0]
+            return toolError(
+              `QUEUE_NOT_TERMINAL: cannot archive subtree of ${message_id} — ` +
+                `message ${first.id} has status '${first.status}' (terminal required: ${terminal.join('/')})`,
+            )
+          }
+          const { count } = await tx.agentMessage.updateMany({
+            where: { id: { in: rows.map((row) => row.id) }, archived_at: null },
+            data: { archived_at: new Date() },
+          })
+          return toolJson({ message_id, total: rows.length, archived: count })
+        })
+      }),
+  )
+
+  server.registerTool(
+    'queue_unarchive',
+    {
+      title: 'Queue unarchive',
+      description:
+        'Restore an archived queue message and its whole reply subtree ' +
+        '(recursively via in_reply_to). No terminal check — an archived chain ' +
+        'can always be restored. Per-row idempotent — non-archived rows are ' +
+        'skipped. Returns { message_id, total, unarchived }.',
+      inputSchema,
+      annotations: { readOnlyHint: false, idempotentHint: true },
+    },
+    async ({ message_id }) =>
+      withToolErrors(async () => {
+        await requireWriteAccess()
+        return prisma.$transaction(async (tx) => {
+          const rows = await lockSubtree(tx, message_id)
+          if (rows.length === 0) {
+            return toolError(`QUEUE_NOT_FOUND: message ${message_id} does not exist`)
+          }
+          const { count } = await tx.agentMessage.updateMany({
+            where: { id: { in: rows.map((row) => row.id) }, archived_at: { not: null } },
+            data: { archived_at: null },
+          })
+          return toolJson({ message_id, total: rows.length, unarchived: count })
+        })
+      }),
+  )
+}
