+/**
+ * Hulp-mock voor de schedule-first flow: onderscheidt de schedule-POST
+ * (body bevat `merge_when_checks_succeed`) van de opportunistiche
+ * directe-POST (body ZONDER dat veld). `directResponses` zijn per poging;
+ * de laatste response wordt herhaald voor verdere pogingen.
+ */
+function mockScheduleThenDirect(opts: {
+  scheduleResponse?: () => Response
+  directResponses?: Array<() => Response>
+} = {}) {
+  const {
+    scheduleResponse,
+    directResponses = [() => new Response('', { status: 200 })],
+  } = opts
+  const scheduleBodies: Array<Record<string, unknown>> = []
+  const directBodies: Array<Record<string, unknown>> = []
+  let directCalls = 0
+
+  const fetchMock = vi.fn(async (url: string, init: RequestInit = {}) => {
+    if (url.endsWith('/api/v1/version')) {
+      return new Response('{"version":"15.0.2"}', { status: 200 })
+    }
+    if (url.endsWith('/swagger.v1.json')) {
+      return new Response(JSON.stringify(FIXTURE_V15), { status: 200 })
+    }
+    if (url.endsWith('/merge') && init.method === 'POST') {
+      const parsed = JSON.parse(init.body as string) as Record<string, unknown>
+      if (parsed.merge_when_checks_succeed !== undefined) {
+        scheduleBodies.push(parsed)
+        return scheduleResponse?.() ?? new Response('', { status: 200 })
+      }
+      directBodies.push(parsed)
+      directCalls++
+      const responder = directResponses[Math.min(directCalls, directResponses.length) - 1]!
+      return responder()
+    }
+    return new Response('', { status: 404 })
+  })
+
+  return {
+    fetchMock,
+    scheduleBodies,
+    directBodies,
+    directCallCount: () => directCalls,
+  }
+}
+
