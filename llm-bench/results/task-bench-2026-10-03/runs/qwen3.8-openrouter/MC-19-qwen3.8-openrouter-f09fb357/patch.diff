+    await expect(
+      dispatchTaskImplementation({ taskId: 't1', productId: 'prod-1', userId: 'u1', requiredCapability: 'local_llm' }),
+    ).rejects.toThrow(/actieve/)
+    expect(mockCreate).not.toHaveBeenCalled()
+  })
 })
 
