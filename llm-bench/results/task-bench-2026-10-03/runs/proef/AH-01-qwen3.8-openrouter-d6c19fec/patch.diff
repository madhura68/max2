+import { describe, expect, it } from 'vitest'
+import { WorkerConfigSchema } from '../src/worker/config.js'
+import { REDACTED, collectSecretEntries, collectSecretValues, redactDeep, redactText, workerSecretSources } from '../src/worker/redact.js'
+
+describe('collectSecretEntries', () => {
+  it('picks every secret-looking key and leaves ordinary values alone', () => {
+    const env = {
+      SCRUM4ME_TOKEN: 'tok-12345678',
+      ANTHROPIC_API_KEY: 'sk-12345678',
+      GITHUB_SECRET: 'ghs-12345678',
+      GIT_PASSWD: 'pw-12345678',
+      MY_PRIVATE_KEY: 'key-12345678',
+      SERVER_KEY: 'skv-12345678',
+      PG_DSN: 'dsn-12345678',
+      CLIENT_CREDENTIALS: 'cr-12345678',
+      HOME: '/home/janpeter',
+      PATH: '/usr/bin:/bin',
+      DATABASE_URL: 'http://not-a-password-carrying-url.example/v1',
+    }
+    expect(collectSecretEntries(env)).toEqual([
+      { name: 'SCRUM4ME_TOKEN', value: 'tok-12345678' },
+      { name: 'ANTHROPIC_API_KEY', value: 'sk-12345678' },
+      { name: 'GITHUB_SECRET', value: 'ghs-12345678' },
+      { name: 'GIT_PASSWD', value: 'pw-12345678' },
+      { name: 'MY_PRIVATE_KEY', value: 'key-12345678' },
+      { name: 'SERVER_KEY', value: 'skv-12345678' },
+      { name: 'PG_DSN', value: 'dsn-12345678' },
+      { name: 'CLIENT_CREDENTIALS', value: 'cr-12345678' },
+    ])
+  })
+
+  it('takes the URL password out of a value under a non-secret key, raw and decoded', () => {
+    const entries = collectSecretEntries({ DATABASE_URL: 'postgres://dbuser:p%40ssword123@dbhost/db' })
+    expect(entries).toEqual([
+      { name: 'DATABASE_URL (url-wachtwoord)', value: 'p%40ssword123' },
+      { name: 'DATABASE_URL (url-wachtwoord)', value: 'p@ssword123' },
+    ])
+  })
+
+  it('takes the URL password once when raw and decoded are identical', () => {
+    expect(collectSecretEntries({ DATABASE_URL: 'postgres://dbuser:plain12345@dbhost/db' })).toEqual([
+      { name: 'DATABASE_URL (url-wachtwoord)', value: 'plain12345' },
+    ])
+  })
+
+  it('takes the full value and the URL password when the key itself is secret-looking', () => {
+    expect(collectSecretEntries({ DB_DSN: 'postgres://dbuser:plain12345@dbhost/db' })).toEqual([
+      { name: 'DB_DSN', value: 'postgres://dbuser:plain12345@dbhost/db' },
+      { name: 'DB_DSN (url-wachtwoord)', value: 'plain12345' },
+    ])
+  })
+
+  it('keeps short values with their names, and drops empty and undefined values', () => {
+    expect(collectSecretEntries({ API_KEY: 'short', OTHER_TOKEN: '', THIRD_SECRET: undefined, EMPTY_TOKEN: '' })).toEqual([
+      { name: 'API_KEY', value: 'short' },
+    ])
+  })
+})
+
+describe('collectSecretValues', () => {
+  it('keeps values from 8 chars, unique, longest first across envs', () => {
+    const a = { TOKEN_A: 'abc12345' } // 8 chars: in
+    const b = { TOKEN_B: 'abc1234567890' } // 13 chars
+    const c = { TOKEN_C: 'short7' } // 6 chars: out
+    const d = { TOKEN_D: 'abc12345' } // duplicate
+    expect(collectSecretValues(a, b, c, d)).toEqual(['abc1234567890', 'abc12345'])
+  })
+
+  it('finds the password in a URL under the key MODEL_BASE_URL', () => {
+    const url = 'http://base-user:baseurl-pass-9876@127.0.0.1:11434/v1'
+    const values = collectSecretValues({ MODEL_BASE_URL: url })
+    expect(values).toContain('baseurl-pass-9876')
+    expect(redactText(url, values)).toBe('http://base-user:***@127.0.0.1:11434/v1')
+  })
+
+  it('every value it yields is present in collectSecretEntries (parity)', () => {
+    const envs = [
+      { FORGEJO_TOKEN: 'forgejo-token-1', DATABASE_URL: 'postgres://u:p%40ssword123@h/db', PG_DSN: 'short' },
+      { MODEL_BASE_URL: 'http://u:baseurl-pass-9876@h/v1', EMPTY_TOKEN: '' },
+    ]
+    const values = collectSecretValues(...envs)
+    const entryValues = collectSecretEntries(...envs).map((e) => e.value)
+    expect(values.length).toBeGreaterThan(0)
+    for (const v of values) expect(entryValues).toContain(v)
+  })
+})
+
+describe('redactText', () => {
+  it('masks several secrets on one line', () => {
+    const t1 = 'tok-12345678'
+    const t2 = 'pw-87654321'
+    expect(redactText(`token=${t1} password=${t2} end`, [t1, t2])).toBe(`token=${REDACTED} password=${REDACTED} end`)
+  })
+
+  it('masks the longer secret whole when given longest first', () => {
+    expect(redactText('abcdefghijklmnop end', ['abcdefghijklmnop', 'abcdefgh'])).toBe(`${REDACTED} end`)
+  })
+
+  it('leaves text without secrets byte-identical', () => {
+    const text = 'gewone tekst met "quotes" en ünïcode àéï, geen secrets hier\nniet-ascii: π≈3.14 en *** als-is'
+    expect(redactText(text, ['abc12345', 'defghijk'])).toBe(text)
+  })
+
+  it('returns empty text unchanged', () => {
+    expect(redactText('', ['abc12345'])).toBe('')
+  })
+})
+
+describe('redactDeep', () => {
+  it('redacts every string in nested objects and arrays, leaving other values intact', () => {
+    const secret = 'sk-abcdef123456'
+    const input = {
+      meta: {
+        name: 'run',
+        level: 3,
+        ok: true,
+        nil: null,
+        nested: { note: `failed with ${secret}`, list: [`x${secret}y`, 'plain', [secret, 42, false]] },
+      },
+      top: 'clean',
+    }
+    const out = redactDeep(input, [secret])
+    expect(out.meta.nested.note).toBe('failed with ***')
+    expect(out.meta.nested.list).toEqual(['x***y', 'plain', ['***', 42, false]])
+    expect(out.meta.level).toBe(3)
+    expect(out.meta.ok).toBe(true)
+    expect(out.meta.nil).toBeNull()
+    expect(out.meta.name).toBe('run')
+    expect(out.top).toBe('clean')
+    // Deep: the input is left untouched.
+    expect(input.meta.nested.note).toBe(`failed with ${secret}`)
+  })
+
+  it('passes plain values through unchanged', () => {
+    expect(redactDeep(42, ['sk-abcdef123456'])).toBe(42)
+    expect(redactDeep(null, ['sk-abcdef123456'])).toBeNull()
+    expect(redactDeep(['a', 1], [])).toEqual(['a', 1])
+  })
+})
+
+describe('workerSecretSources', () => {
+  const config = WorkerConfigSchema.parse({
+    model: { baseUrl: 'http://base-user:base-pass-9876@127.0.0.1:11434/v1', name: 'qwen3-coder:30b', apiKey: 'sk-worker-key-123456' },
+    mcp: { command: 'node', args: ['server.js'], env: { SCRUM4ME_TOKEN: '${SCRUM4ME_TOKEN}' } },
+  })
+  const processEnv = { FORGEJO_TOKEN: 'forgejo-token-123456', SCRUM4ME_TOKEN: 'scrum4me-token-123456' }
+
+  it('lists the four sources and yields a value from each of them', () => {
+    const sources = workerSecretSources(config, processEnv)
+    expect(sources).toHaveLength(3)
+    const values = collectSecretValues(...sources)
+    expect(values).toContain('forgejo-token-123456') // process.env
+    expect(values).toContain('scrum4me-token-123456') // workerMcpEnv (expanded)
+    expect(values).toContain('sk-worker-key-123456') // model.apiKey
+    expect(values).toContain('base-pass-9876') // password of model.baseUrl
+  })
+
+  it('works without an apiKey', () => {
+    const cfg = WorkerConfigSchema.parse({
+      model: { baseUrl: 'http://127.0.0.1:11434/v1', name: 'qwen3-coder:30b' },
+      mcp: { command: 'node', args: [] },
+    })
+    const values = collectSecretValues(...workerSecretSources(cfg, { FORGEJO_TOKEN: 'forgejo-token-123456' }))
+    expect(values).toContain('forgejo-token-123456')
+  })
+})
