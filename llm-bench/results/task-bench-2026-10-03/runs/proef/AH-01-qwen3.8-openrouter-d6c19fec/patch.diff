+import type { WorkerConfig } from './config.js'
+import { workerMcpEnv } from './config.js'
+
+/** The replacement for every redacted secret (scrum4me-docker `lib/log-redact.ts`, 52ded13). */
+export const REDACTED = '***'
+
+/**
+ * Secret selection copied from scrum4me-docker `lib/log-redact.ts:9-58` (52ded13).
+ * The stream line buffer (`:60-88`) is not needed here: the run-log writer redacts
+ * whole lines before truncating.
+ */
+const SECRET_KEY_RE = /(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|PRIVATE_KEY|_KEY$|DSN|CREDENTIAL)/i
+const MIN_SECRET_LENGTH = 8
+
+/**
+ * The password of a URL value, raw and decoded. Empty when the value carries no
+ * user info or has no password part.
+ */
+function urlPasswords(value: string): string[] {
+  const out: string[] = []
+  const push = (raw: string | null) => {
+    if (!raw) return
+    out.push(raw)
+    try {
+      const decoded = decodeURIComponent(raw)
+      if (decoded !== raw) out.push(decoded)
+    } catch {
+      // Malformed percent-encoding: the raw form is already captured.
+    }
+  }
+  try {
+    const u = new URL(value)
+    if (u.password) push(u.password)
+  } catch {
+    // Not a parseable URL: try the classic user:pass@host shape so DSN-like strings still count.
+    const m = value.match(/^(?:[a-z][a-z0-9+.-]*:)?\/\/(?:[^:@/]*:)([^@/]+)@/)
+    if (m) push(m[1])
+  }
+  return out
+}
+
+/**
+ * Alle kandidaten met hun bron: de waarde van een variabele met een geheim-achtige naam, en het
+ * wachtwoord uit elke URL-waarde (ruw en gedecodeerd). Zonder lengtefilter; lege waarden vallen weg.
+ */
+export function collectSecretEntries(...envs: Array<Record<string, string | undefined>>): { name: string; value: string }[] {
+  const out: { name: string; value: string }[] = []
+  for (const env of envs) {
+    for (const [name, value] of Object.entries(env)) {
+      if (!value) continue
+      if (SECRET_KEY_RE.test(name)) out.push({ name, value })
+      for (const password of urlPasswords(value)) out.push({ name: `${name} (url-wachtwoord)`, value: password })
+    }
+  }
+  return out
+}
+
+/**
+ * De redactieset: de waarden uit collectSecretEntries vanaf 8 tekens, uniek, langste eerst
+ * (= de runnerregel).
+ */
+export function collectSecretValues(...envs: Array<Record<string, string | undefined>>): string[] {
+  return [...new Set(collectSecretEntries(...envs).map((e) => e.value).filter((v) => v.length >= MIN_SECRET_LENGTH))].sort((a, b) => b.length - a.length)
+}
+
+/** Vervangt elke secret in de tekst door `***` (copie van de runnerregel, scrum4me-docker `lib/log-redact.ts:49-58`). */
+export function redactText(text: string, secrets: readonly string[]): string {
+  let out = text
+  for (const secret of secrets) {
+    if (!secret) continue
+    out = out.split(secret).join(REDACTED)
+  }
+  return out
+}
+
+/**
+ * Redigeert elke string in een JSON-waarde (objecten en arrays recursief); andere waarden
+ * blijven gelijk. De input wordt niet gewijzigd.
+ */
+export function redactDeep<T>(value: T, secrets: readonly string[]): T {
+  if (typeof value === 'string') return redactText(value, secrets) as T
+  if (Array.isArray(value)) return value.map((v) => redactDeep(v, secrets)) as T
+  if (value !== null && typeof value === 'object') {
+    const out: Record<string, unknown> = {}
+    for (const [k, v] of Object.entries(value)) out[k] = redactDeep(v, secrets)
+    return out as T
+  }
+  return value
+}
+
+/**
+ * De geheimbronnen van de worker, in volgorde: process.env, de opgeloste MCP-omgeving en het
+ * modelblok (apiKey en het wachtwoord van baseUrl, als zelfstandige configvelden). De worker
+ * (Taak 5) en de controle (Taak 7) gebruiken allebei deze lijst.
+ */
+export function workerSecretSources(config: WorkerConfig, processEnv: NodeJS.ProcessEnv = process.env): Array<Record<string, string | undefined>> {
+  return [processEnv, workerMcpEnv(config, processEnv), { MODEL_API_KEY: config.model.apiKey, MODEL_BASE_URL: config.model.baseUrl }]
+}
