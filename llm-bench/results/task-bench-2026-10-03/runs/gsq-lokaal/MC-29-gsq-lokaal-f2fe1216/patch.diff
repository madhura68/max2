+type MergeCall = {
+  kind: 'schedule' | 'direct'
+  body: Record<string, unknown>
+}
+
+/**
+ * Hulp-mock voor de schedule-first flow: onderscheidt de schedule-POST
+ * (body bevat `merge_when_checks_succeed`) van de directe-merge-POST's
+ * (body zonder dat veld). `scheduleResponse` geldt voor de schedule-POST;
+ * `directResponses` is een per-poging queue voor de directe-merge-lus
+ * (default: 200).
+ */
+function mockScheduleThenDirect(opts: {
+  scheduleResponse?: Response
+  directResponses?: Response[]
+  versionResponse?: () => Response
+} = {}) {
+  const { scheduleResponse, directResponses = [], versionResponse } = opts
+  const calls: MergeCall[] = []
+  const fetchMock = vi.fn(async (url: string, init: RequestInit = {}) => {
+    if (url.endsWith('/api/v1/version')) {
+      return (
+        versionResponse?.() ?? new Response('{\"version\":\"15.0.2\"}', { status: 200 })
+      )
+    }
+    if (url.endsWith('/swagger.v1.json')) {
+      return new Response(JSON.stringify(FIXTURE_V15), { status: 200 })
+    }
+    if (url.endsWith('/merge') && init.method === 'POST') {
+      const body = JSON.parse((init.body as string) || '{}') as Record<string, unknown>
+      const kind: 'schedule' | 'direct' =
+        'merge_when_checks_succeed' in body ? 'schedule' : 'direct'
+      calls.push({ kind, body })
+      if (kind === 'schedule') {
+        return scheduleResponse ?? new Response('', { status: 200 })
+      }
+      const directIdx = calls.filter((c) => c.kind === 'direct').length - 1
+      return directResponses[directIdx] ?? new Response('', { status: 200 })
+    }
+    return new Response('', { status: 404 })
+  })
+  return {
+    calls,
+    scheduleCallCount: () => calls.filter((c) => c.kind === 'schedule').length,
+    directCallCount: () => calls.filter((c) => c.kind === 'direct').length,
+    fetch: fetchMock,
+  }
+}
+
+function http(status: number, body?: string): Response {
+  return new Response(body ?? '', { status })
+}
+
