+describe('runManifest — cost, reasoning tokens and provider', () => {
+  const readResponses = (trace: { dir: string }) => readTrace(trace.dir).filter((e) => e.type === 'model_response')
+
+  it('carries the provider on model_response and sums costUsd and reasoningTokens over the reported ones', async () => {
+    const second = completion({ content: 'done', usage: { prompt_tokens: 6, completion_tokens: 3 } })
+    second.provider = 'Ollama'
+    fake = await startFakeModelServer([
+      { body: readFileSync(join('__tests__', 'fixtures', 'openrouter-chat-completion.json'), 'utf8') },
+      { body: second },
+    ])
+    const m = manifest(fake.baseUrl)
+    const trace = openTrace(tmp('run'), m.id)
+    const afterAnswer = vi.fn<(answer: string, signal: AbortSignal) => Promise<AfterAnswerResult>>()
+      .mockResolvedValueOnce({ kind: 'retry', message: 'Nogmaals.' })
+      .mockResolvedValueOnce({ kind: 'accept' })
+    const result = await runManifest(m, {
+      client: createModelClient({ baseUrl: m.model.baseUrl, name: m.model.name }),
+      trace,
+      connectRegistry: async () => { throw new Error('unused') },
+      afterAnswer,
+    })
+    expect(result.status).toBe('completed')
+    // Only the fixture turn reported cost and reasoning tokens; the sum counts exactly that.
+    expect(result.usage.costUsd).toBeCloseTo(7.95e-05)
+    expect(result.usage.reasoningTokens).toBe(27)
+    const responses = readResponses(trace)
+    expect(responses).toHaveLength(2)
+    expect(responses[0]).toMatchObject({ type: 'model_response', provider: 'AkashML', usage: { costUsd: 7.95e-05, reasoningTokens: 27 } })
+    expect(responses[1].provider).toBe('Ollama') // each response keeps its own provider
+  })
+
+  it('omits costUsd and reasoningTokens from the result when no response reported them', async () => {
+    fake = await startFakeModelServer([{ body: completion({ content: 'x', usage: { prompt_tokens: 5, completion_tokens: 2 } }) }])
+    const m = manifest(fake.baseUrl)
+    const trace = openTrace(tmp('run'), m.id)
+    const result = await runManifest(m, {
+      client: createModelClient({ baseUrl: m.model.baseUrl, name: m.model.name }),
+      trace,
+      connectRegistry: async () => { throw new Error('unused') },
+    })
+    expect(result.status).toBe('completed')
+    expect(result.usage.costUsd).toBeUndefined()
+    expect(result.usage.reasoningTokens).toBeUndefined()
+    expect(JSON.parse(readFileSync(join(trace.dir, 'result.json'), 'utf8')).usage).not.toHaveProperty('costUsd')
+    expect(JSON.parse(readFileSync(join(trace.dir, 'result.json'), 'utf8')).usage).not.toHaveProperty('reasoningTokens')
+  })
+})
