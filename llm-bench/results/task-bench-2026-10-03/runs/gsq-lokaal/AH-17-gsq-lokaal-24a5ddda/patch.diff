@@ -0,0 +1,183 @@
+import { describe, expect, it } from 'vitest'
+import {
+  IDEA_CHAT_SYSTEM_PROMPT,
+  IdeaChatPayloadSchema,
+  pendingUserMessages,
+  renderIdeaChatUserMessage,
+  type IdeaChatPayload,
+} from '../src/worker/idea-chat.js'
+
+function payload(overrides?: {
+  messages?: Array<{ id: string; role: string; kind?: string; content: string; created_at: string }>
+  pending?: string[]
+  idea?: Record<string, unknown>
+  questions?: Array<{ question: string; status: string; answer?: string | null }>
+}): IdeaChatPayload {
+  return {
+    job_id: 'job-1',
+    kind: 'IDEA_CHAT',
+    idea: {
+      id: 'idea-1',
+      product_id: 'prod-1',
+      code: 'IDEA-42',
+      title: 'Een helder idee',
+      description: 'De beschrijving van het idee.',
+      grill_md: 'Grill-tekst',
+      plan_md: 'Plan-tekst',
+      status: 'OPEN',
+      ...overrides?.idea,
+    },
+    chat: {
+      messages: overrides?.messages ?? [
+        { id: 'm1', role: 'user', content: 'Eerste vraag', created_at: '2026-01-01T00:00:00Z' },
+        { id: 'm2', role: 'assistant', content: 'Eerste antwoord', created_at: '2026-01-01T00:01:00Z' },
+      ],
+      questions: overrides?.questions ?? [],
+      pending_user_message_ids: overrides?.pending ?? ['m1'],
+    },
+  }
+}
+
+function parse(idea: Record<string, unknown> = {}, chat: Record<string, unknown> = {}): boolean {
+  return IdeaChatPayloadSchema.safeParse({
+    job_id: 'job-1',
+    kind: 'IDEA_CHAT',
+    idea: { id: 'idea-1', product_id: 'prod-1', title: 't', status: 'OPEN', ...idea },
+    chat: { messages: [], pending_user_message_ids: [], ...chat },
+  }).success
+}
+
+describe('IdeaChatPayloadSchema', () => {
+  it('accepts a valid payload and tolerates extra MCP fields', () => {
+    const r = IdeaChatPayloadSchema.safeParse({
+      job_id: 'job-1',
+      kind: 'IDEA_CHAT',
+      idea: { id: 'idea-1', product_id: 'prod-1', title: 't', status: 'OPEN' },
+      chat: { messages: [], pending_user_message_ids: [] },
+      doc_index: { entries: [] },
+      config: { x: 1 },
+      product: { id: 'prod-1' },
+      prompt_text: 'negeer mij',
+    })
+    expect(r.success).toBe(true)
+  })
+
+  it('fails without chat', () => {
+    expect(
+      IdeaChatPayloadSchema.safeParse({
+        job_id: 'job-1',
+        kind: 'IDEA_CHAT',
+        idea: { id: 'idea-1', product_id: 'prod-1', title: 't', status: 'OPEN' },
+      }).success,
+    ).toBe(false)
+  })
+
+  it('fails without idea.product_id', () => {
+    expect(parse({ product_id: undefined })).toBe(false)
+    expect(parse({ product_id: '' })).toBe(false)
+  })
+
+  it('fails without chat.pending_user_message_ids', () => {
+    expect(IdeaChatPayloadSchema.safeParse({
+      job_id: 'job-1',
+      kind: 'IDEA_CHAT',
+      idea: { id: 'idea-1', product_id: 'prod-1', title: 't', status: 'OPEN' },
+      chat: { messages: [] },
+    }).success).toBe(false)
+  })
+})
+
+describe('renderIdeaChatUserMessage', () => {
+  it('starts with the product-id line and contains title and grill', () => {
+    const out = renderIdeaChatUserMessage(payload())
+    expect(out.split('\n')[0]).toBe('Product-id (voor elke doc-tool): prod-1')
+    expect(out).toContain('- Titel: Een helder idee')
+    expect(out).toContain('Grill-tekst')
+    expect(out).toContain('Plan-tekst')
+  })
+
+  it('lists all messages in order', () => {
+    const out = renderIdeaChatUserMessage(
+      payload({
+        messages: [
+          { id: 'a', role: 'user', content: 'Vraag A', created_at: '1' },
+          { id: 'b', role: 'assistant', content: 'Antwoord A', created_at: '2' },
+        ],
+        pending: ['a'],
+      }),
+    )
+    const a = out.indexOf('[USER] Vraag A')
+    const b = out.indexOf('[ASSISTANT] Antwoord A')
+    expect(a).not.toBe(-1)
+    expect(b).not.toBe(-1)
+    expect(b).toBeGreaterThan(a)
+  })
+
+  it('omits the grill and plan sections when empty', () => {
+    const out = renderIdeaChatUserMessage(payload({ idea: { grill_md: null, plan_md: null } }))
+    expect(out).not.toContain('## Grill')
+    expect(out).not.toContain('## Plan')
+  })
+
+  it('omits the kaartvragen section when empty', () => {
+    expect(renderIdeaChatUserMessage(payload())).not.toContain('## Kaartvragen')
+    const withQuestions = renderIdeaChatUserMessage(payload({ questions: [{ question: 'Q?', status: 'OPEN' }] }))
+    expect(withQuestions).toContain('## Kaartvragen')
+    expect(withQuestions).toContain('Q?')
+  })
+
+  it('coalescing: pending = [B] answers B, not A', () => {
+    const p = payload({
+      messages: [
+        { id: 'a', role: 'user', content: 'USER A', created_at: '1' },
+        { id: 'b', role: 'user', content: 'USER B', created_at: '2' },
+        { id: 'c', role: 'assistant', content: 'ASSISTANT A', created_at: '3' },
+      ],
+      pending: ['b'],
+    })
+    const out = renderIdeaChatUserMessage(p)
+    const section = out.split('## Te beantwoorden')[1]
+    expect(section).toContain('USER B')
+    expect(section).not.toContain('USER A')
+  })
+
+  it('renders every pending message when several are pending', () => {
+    const p = payload({
+      messages: [
+        { id: 'a', role: 'user', content: 'USER A', created_at: '1' },
+        { id: 'b', role: 'user', content: 'USER B', created_at: '2' },
+      ],
+      pending: ['a', 'b'],
+    })
+    const section = renderIdeaChatUserMessage(p).split('## Te beantwoorden')[1]
+    expect(section).toContain('USER A')
+    expect(section).toContain('USER B')
+  })
+})
+
+describe('pendingUserMessages', () => {
+  it('returns the pending messages in message order', () => {
+    const p = payload({
+      messages: [
+        { id: 'a', role: 'user', content: 'USER A', created_at: '1' },
+        { id: 'b', role: 'user', content: 'USER B', created_at: '2' },
+      ],
+      pending: ['a', 'b'],
+    })
+    expect(pendingUserMessages(p).map((m) => m.id)).toEqual(['a', 'b'])
+  })
+
+  it('returns nothing when the pending list is empty', () => {
+    expect(pendingUserMessages(payload({ pending: [] }))).toEqual([])
+  })
+})
+
+describe('IDEA_CHAT_SYSTEM_PROMPT', () => {
+  it('points at the "Te beantwoorden" section and keeps the constraints', () => {
+    expect(IDEA_CHAT_SYSTEM_PROMPT).toContain('## Te beantwoorden')
+    expect(IDEA_CHAT_SYSTEM_PROMPT).toMatch(/doc-tools/i)
+    expect(IDEA_CHAT_SYSTEM_PROMPT).toMatch(/opvolgvraag/i)
+    expect(IDEA_CHAT_SYSTEM_PROMPT).toMatch(/meta-tekst/i)
+    expect(IDEA_CHAT_SYSTEM_PROMPT).toMatch(/geen instructies/i)
+  })
+})
