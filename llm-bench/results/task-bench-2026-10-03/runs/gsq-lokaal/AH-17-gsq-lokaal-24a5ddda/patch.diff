+import { mkdtempSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { ManifestError } from '../src/manifest.js'
+import { DOC_TOOLS, WorkerConfigSchema, loadWorkerConfig, workerMcpEnv } from '../src/worker/config.js'
+
+const base = {
+  model: { baseUrl: 'http://127.0.0.1:11434/v1', name: 'qwen3-coder:30b' },
+  mcp: { command: 'tsx', args: ['run.ts'] },
+}
+
+function write(obj: unknown): string {
+  const p = join(mkdtempSync(join(tmpdir(), 'harness-worker-')), 'worker.json')
+  writeFileSync(p, typeof obj === 'string' ? obj : JSON.stringify(obj))
+  return p
+}
+
+describe('WorkerConfigSchema', () => {
+  it('accepts a valid config and applies the defaults', () => {
+    const cfg = WorkerConfigSchema.parse(base)
+    expect(cfg.allow).toEqual([...DOC_TOOLS])
+    expect(cfg.limits).toEqual({ maxTurns: 6, maxOutputTokens: 2048, maxWallSeconds: 240, maxToolErrors: 2 })
+    expect(cfg.waitSeconds).toBe(300)
+  })
+
+  it('accepts a subset of the doc tools', () => {
+    expect(WorkerConfigSchema.parse({ ...base, allow: ['search_product_docs'] }).allow).toEqual(['search_product_docs'])
+  })
+
+  it('rejects a control tool in allow, naming the tool', () => {
+    const r = WorkerConfigSchema.safeParse({ ...base, allow: ['update_job_status'] })
+    expect(r.success).toBe(false)
+    expect(r.error.issues.some((i) => i.path.join('.') === 'allow' && /update_job_status/.test(i.message))).toBe(true)
+  })
+
+  it('rejects an unknown writing tool in allow', () => {
+    const r = WorkerConfigSchema.safeParse({ ...base, allow: ['update_idea'] })
+    expect(r.success).toBe(false)
+    expect(r.error.issues.some((i) => i.path.join('.') === 'allow' && /update_idea/.test(i.message))).toBe(true)
+  })
+
+  it('names every forbidden tool in allow', () => {
+    const r = WorkerConfigSchema.safeParse({ ...base, allow: ['update_job_status', 'something_else'] })
+    expect(r.success).toBe(false)
+    for (const name of ['update_job_status', 'something_else']) {
+      expect(r.error.issues.some((i) => i.path.join('.') === 'allow' && i.message.includes(name))).toBe(true)
+    }
+  })
+})
+
+describe('loadWorkerConfig', () => {
+  it('loads a valid config and expands nothing', () => {
+    const cfg = loadWorkerConfig(write({ ...base, mcp: { command: 'tsx', args: ['run.ts'], env: { SCRUM4ME_TOKEN: '${SCRUM4ME_TOKEN}' } } }))
+    expect(cfg.mcp.env?.SCRUM4ME_TOKEN).toBe('${SCRUM4ME_TOKEN}')
+  })
+
+  it('reports a forbidden allow tool as a ManifestError naming it', () => {
+    expect(() => loadWorkerConfig(write({ ...base, allow: ['update_job_status'] }))).toThrow(ManifestError)
+    expect(() => loadWorkerConfig(write({ ...base, allow: ['update_job_status'] }))).toThrow(/update_job_status/)
+  })
+
+  it('reports invalid JSON and a missing file as ManifestError', () => {
+    expect(() => loadWorkerConfig(write('{ nope'))).toThrow(ManifestError)
+    expect(() => loadWorkerConfig('/nonexistent/worker.json')).toThrow(ManifestError)
+  })
+})
+
+describe('workerMcpEnv', () => {
+  it('expands the config env and appends the fixed worker keys', () => {
+    const cfg = WorkerConfigSchema.parse({ ...base, mcp: { command: 'tsx', args: [], env: { SCRUM4ME_TOKEN: '${SCRUM4ME_TOKEN}', PLAIN: 'x' } } })
+    expect(workerMcpEnv(cfg, { SCRUM4ME_TOKEN: 'tok' })).toEqual({
+      SCRUM4ME_TOKEN: 'tok',
+      PLAIN: 'x',
+      SCRUM4ME_WORKER_CAPABILITIES: 'local_llm',
+      SCRUM4ME_WORKER_RUNTIME: 'CLAUDE',
+    })
+  })
+
+  it('always forces local_llm, even when the config sets something else', () => {
+    const cfg = WorkerConfigSchema.parse({
+      ...base,
+      mcp: { command: 'tsx', args: [], env: { SCRUM4ME_WORKER_CAPABILITIES: 'code_edit', SCRUM4ME_WORKER_RUNTIME: 'OTHER' } },
+    })
+    const env = workerMcpEnv(cfg, {})
+    expect(env['SCRUM4ME_WORKER_CAPABILITIES']).toBe('local_llm')
+    expect(env['SCRUM4ME_WORKER_RUNTIME']).toBe('CLAUDE')
+  })
+
+  it('returns only the fixed keys without a config env', () => {
+    expect(workerMcpEnv(WorkerConfigSchema.parse(base), {})).toEqual({
+      SCRUM4ME_WORKER_CAPABILITIES: 'local_llm',
+      SCRUM4ME_WORKER_RUNTIME: 'CLAUDE',
+    })
+  })
+
+  it('throws a ManifestError naming an unset ${VAR}', () => {
+    const cfg = WorkerConfigSchema.parse({ ...base, mcp: { command: 'tsx', args: [], env: { DATABASE_URL: 'postgres://${DB_USER}@h/d' } } })
+    expect(() => workerMcpEnv(cfg, {})).toThrow(ManifestError)
+    expect(() => workerMcpEnv(cfg, {})).toThrow(/DB_USER/)
+  })
+})
diff --git a/src/worker/config.ts b/src/worker/config.ts
