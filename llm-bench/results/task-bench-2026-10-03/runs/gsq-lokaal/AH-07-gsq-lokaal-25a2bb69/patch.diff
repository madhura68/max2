@@ -0,0 +1,93 @@
+import { describe, expect, it } from 'vitest'
+import type { ToolExecResult, ToolRegistry, ToolSnapshotEntry } from '../src/types.js'
+import { capDocArgs, DOC_MAX_CHARS } from '../src/worker/doc-tools.js'
+
+const sig = () => AbortSignal.timeout(5000)
+
+/** A fake ToolRegistry that records the args of every execute call. */
+function fakeRegistry(names: string[], opts?: { onExecute?: (name: string, args: Record<string, unknown>) => void; onClose?: () => void }): { view: ToolRegistry; calls: Array<{ name: string; args: Record<string, unknown> }> } {
+  const calls: Array<{ name: string; args: Record<string, unknown> }> = []
+  const entries: ToolSnapshotEntry[] = names.map((name) => ({ name, inputSchema: { type: 'object', properties: {} } }))
+  const view: ToolRegistry = {
+    snapshot: { entries, hash: `hash-${names.join(',')}` },
+    toOpenAiTools() {
+      return entries.map((e) => ({ type: 'function' as const, function: { name: e.name, parameters: e.inputSchema } }))
+    },
+    async execute(name, args): Promise<ToolExecResult> {
+      calls.push({ name, args })
+      opts?.onExecute?.(name, args)
+      return { ok: true, content: `${name} called`, truncated: false }
+    },
+    async close(): Promise<void> {
+      opts?.onClose?.()
+    },
+  }
+  return { view, calls }
+}
+
+describe('capDocArgs', () => {
+  it('caps get_product_doc max_chars of 40 000 at DOC_MAX_CHARS, keeping offset and heading', async () => {
+    const { view, calls } = fakeRegistry(['get_product_doc', 'search_product_docs'])
+    const wrapped = capDocArgs(view)
+    await wrapped.execute('get_product_doc', { product_id: 'p1', folder: 'plans', slug: 'x', max_chars: 40_000, offset: 12_000, heading: 'Plan' }, sig())
+    expect(calls).toEqual([{
+      name: 'get_product_doc',
+      args: { product_id: 'p1', folder: 'plans', slug: 'x', max_chars: DOC_MAX_CHARS, offset: 12_000, heading: 'Plan' },
+    }])
+  })
+
+  it.each([DOC_MAX_CHARS, 8_000])('passes max_chars of %d through unchanged', async (maxChars) => {
+    const { view, calls } = fakeRegistry(['get_product_doc'])
+    await capDocArgs(view).execute('get_product_doc', { product_id: 'p1', max_chars: maxChars }, sig())
+    expect(calls).toEqual([{ name: 'get_product_doc', args: { product_id: 'p1', max_chars: maxChars } }])
+  })
+
+  it('passes a call without max_chars through unchanged', async () => {
+    const { view, calls } = fakeRegistry(['get_product_doc'])
+    await capDocArgs(view).execute('get_product_doc', { product_id: 'p1' }, sig())
+    expect(calls).toEqual([{ name: 'get_product_doc', args: { product_id: 'p1' } }])
+  })
+
+  it('leaves a non-numeric max_chars untouched', async () => {
+    const { view, calls } = fakeRegistry(['get_product_doc'])
+    await capDocArgs(view).execute('get_product_doc', { product_id: 'p1', max_chars: 'a lot' }, sig())
+    expect(calls).toEqual([{ name: 'get_product_doc', args: { product_id: 'p1', max_chars: 'a lot' } }])
+  })
+
+  it('does not touch search_product_docs, even with its own max_chars field', async () => {
+    const { view, calls } = fakeRegistry(['get_product_doc', 'search_product_docs'])
+    await capDocArgs(view).execute('search_product_docs', { query: 'x', max_chars: 40_000 }, sig())
+    expect(calls).toEqual([{ name: 'search_product_docs', args: { query: 'x', max_chars: 40_000 } }])
+  })
+
+  it('passes other tools and their arguments through unchanged', async () => {
+    const { view, calls } = fakeRegistry(['create_product', 'get_product_doc'])
+    await capDocArgs(view).execute('create_product', { name: 'x', extra: 1 }, sig())
+    expect(calls).toEqual([{ name: 'create_product', args: { name: 'x', extra: 1 } }])
+  })
+
+  it('keeps the snapshot reference (and hash) and the toOpenAiTools result identical', () => {
+    const docSchema = { type: 'object', properties: { max_chars: { type: 'integer', maximum: 40_000 } } }
+    const view: ToolRegistry = {
+      snapshot: { entries: [{ name: 'get_product_doc', inputSchema: docSchema }, { name: 'search_product_docs', inputSchema: docSchema }], hash: 'h' },
+      toOpenAiTools() {
+        return [{ type: 'function', function: { name: 'get_product_doc', parameters: docSchema } }]
+      },
+      async execute(): Promise<ToolExecResult> {
+        return { ok: true, content: '', truncated: false }
+      },
+      async close() {},
+    }
+    const wrapped = capDocArgs(view)
+    expect(wrapped.snapshot).toBe(view.snapshot)
+    expect(wrapped.snapshot.hash).toBe(view.snapshot.hash)
+    expect(wrapped.toOpenAiTools()).toEqual(view.toOpenAiTools())
+  })
+
+  it('forwards close()', async () => {
+    let closed = false
+    const { view } = fakeRegistry(['get_product_doc'], { onClose: () => { closed = true } })
+    await capDocArgs(view).close()
+    expect(closed).toBe(true)
+  })
+})
