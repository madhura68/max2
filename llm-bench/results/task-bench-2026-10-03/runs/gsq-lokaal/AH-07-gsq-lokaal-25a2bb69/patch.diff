+++ b/src/worker/doc-tools.ts
@@ -0,0 +1,29 @@
+import type { ToolRegistry } from '../types.js'
+
+/**
+ * The MCP allows max_chars up to 40 000 for get_product_doc, but above roughly 15 400 characters
+ * the JSON answer passes TOOL_OUTPUT_LIMIT (16 384 bytes) and the registry clips off the tail —
+ * exactly the part carrying `truncated` and `next_offset`. 12 000 is the MCP default, and even the
+ * largest doc stays under 12.9 KB at that limit.
+ */
+export const DOC_MAX_CHARS = 12_000
+
+/**
+ * Wraps a doc-tools view so get_product_doc never asks the MCP for more than DOC_MAX_CHARS
+ * characters. The snapshot, toOpenAiTools and close pass through untouched: the schema the model
+ * sees must not change, because a lower maximum would make policy.ts reject the call with
+ * SCHEMA_MISMATCH — which counts as a tool error (maxToolErrors 2).
+ */
+export function capDocArgs(view: ToolRegistry): ToolRegistry {
+  return {
+    snapshot: view.snapshot,
+    toOpenAiTools: view.toOpenAiTools.bind(view),
+    async execute(name, args, signal) {
+      if (name === 'get_product_doc' && typeof args.max_chars === 'number' && args.max_chars > DOC_MAX_CHARS) {
+        return view.execute(name, { ...args, max_chars: DOC_MAX_CHARS }, signal)
+      }
+      return view.execute(name, args, signal)
+    },
+    close: view.close.bind(view),
+  }
+}
