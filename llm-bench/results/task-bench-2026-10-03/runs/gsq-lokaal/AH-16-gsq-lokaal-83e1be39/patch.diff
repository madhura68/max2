+        return result ? { ok: true, result } : { ok: false, message: `verify_task_against_plan gaf geen herkenbaar resultaat: ${text(res).slice(0, 200)}` }
+      } catch (err) {
+        return { ok: false, message: message(err) }
+      }
+    },
+
+    async log(kind, args) {
+      // Best-effort: a failed log must never break the run, but it must be visible in the worker log.
+      const name = kind === 'implementation' ? 'log_implementation' : kind === 'commit' ? 'log_commit' : 'log_test_result'
+      const toolArgs: Record<string, unknown> = { story_id: args.storyId, task_id: args.taskId }
+      if (kind === 'commit') {
+        if (args.commitHash !== undefined) toolArgs.commit_hash = args.commitHash
+        if (args.commitMessage !== undefined) toolArgs.commit_message = args.commitMessage
+      } else if (kind === 'test') {
+        if (args.status !== undefined) toolArgs.status = args.status
+      }
+      try {
+        const res = await client.callTool({ name, arguments: { ...toolArgs, content: args.content } })
+        if (res.isError) logTool(name, new Error(text(res)))
+      } catch (err) {
+        logTool(name, err)
+      }
+    },
   }
 }
