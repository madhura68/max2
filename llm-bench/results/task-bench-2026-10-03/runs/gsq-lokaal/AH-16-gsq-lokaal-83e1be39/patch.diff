+/** Trim, lowercase the host, and strip a trailing '/' and '.git' so recipe lookups compare like URLs compare. */
+export function normalizeRepoUrl(url: string): string {
+  const m = url.trim().match(/^(\w[\w+.-]*:\/\/)([^/]*)(.*)$/)
+  const rest = m ? stripSuffixes(`${m[1]}${m[2].toLowerCase()}${m[3]}`) : stripSuffixes(url.trim())
+  return rest.endsWith('/') ? rest.slice(0, -1) : rest
+}
+
+function stripSuffixes(url: string): string {
+  let out = url
+  if (out.endsWith('/') && out.length > 1) out = out.slice(0, -1)
+  if (out.toLowerCase().endsWith('.git')) out = out.slice(0, -4)
+  if (out.endsWith('/') && out.length > 1) out = out.slice(0, -1)
+  return out
+}
