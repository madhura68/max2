+import { describe, expect, it } from 'vitest'
+import { startFakeMcp } from './fakes/fake-mcp-server.js'
+import { connectRegistry } from '../src/tools/registry.js'
+import { createPolicy } from '../src/tools/policy.js'
+import type { ToolCall, ToolSnapshot } from '../src/types.js'
+
+function call(name: string, args: string): ToolCall {
+  return { id: 'c1', name, arguments: args, argumentsWasObject: false }
+}
+
+const snapshot: ToolSnapshot = {
+  entries: [
+    { name: 'echo', inputSchema: { type: 'object', properties: { text: { type: 'string' } }, required: ['text'] } },
+    { name: 'no_required', inputSchema: { type: 'object', properties: { a: { type: 'string' } } } },
+  ],
+  hash: 'x',
+}
+
+describe('createPolicy', () => {
+  const policy = createPolicy(snapshot)
+
+  it('accepts a valid call and returns the parsed args', () => {
+    expect(policy.check(call('echo', '{"text": "hoi"}'))).toEqual({ ok: true, name: 'echo', args: { text: 'hoi' } })
+  })
+
+  it('rejects an unknown tool before JSON and schema checks', () => {
+    const d = policy.check(call('nope', 'not json at all'))
+    expect(d).toMatchObject({ ok: false, errorCode: 'UNKNOWN_TOOL' })
+  })
+
+  it('rejects non-JSON arguments with MALFORMED_ARGS', () => {
+    const d = policy.check(call('echo', '{"text": }'))
+    expect(d).toMatchObject({ ok: false, errorCode: 'MALFORMED_ARGS' })
+  })
+
+  it('rejects JSON that is not an object with MALFORMED_ARGS', () => {
+    for (const args of ['42', 'null', '[1]']) {
+      expect(policy.check(call('echo', args))).toMatchObject({ ok: false, errorCode: 'MALFORMED_ARGS' })
+    }
+  })
+
+  it('accepts an empty string as {} only when the schema has no required', () => {
+    expect(policy.check(call('no_required', ''))).toEqual({ ok: true, name: 'no_required', args: {} })
+    expect(policy.check(call('echo', ''))).toMatchObject({ ok: false, errorCode: 'SCHEMA_MISMATCH' })
+  })
+
+  it('rejects arguments that fail the schema with SCHEMA_MISMATCH and the ajv message', () => {
+    const d = policy.check(call('echo', '{"text": 42}'))
+    expect(d).toMatchObject({ ok: false, errorCode: 'SCHEMA_MISMATCH' })
+    expect((d as { message: string }).message).toContain('must be string')
+  })
+
+  it('allows extra properties when the snapshot schema does not set additionalProperties', () => {
+    expect(policy.check(call('echo', '{"text": "ok", "extra": 1}'))).toMatchObject({ ok: true, args: { text: 'ok', extra: 1 } })
+  })
+
+  it('still rejects an empty {} when the snapshot schema has required', () => {
+    const d = policy.check(call('echo', '{}'))
+    expect(d).toMatchObject({ ok: false, errorCode: 'SCHEMA_MISMATCH' })
+    expect((d as { message: string }).message).toContain('must have required property')
+  })
+})
+
+describe('schemas as the SDK actually emits them', () => {
+  it('compiles the real draft-07 inputSchema (with $schema) from an McpServer registerTool', async () => {
+    const fake = await startFakeMcp()
+    try {
+      const reg = await connectRegistry(fake.client, ['echo'])
+      const schema = reg.snapshot.entries[0].inputSchema
+      expect(schema.$schema).toBe('http://json-schema.org/draft-07/schema#')
+
+      const policy = createPolicy(reg.snapshot)
+      const ok = policy.check(call('echo', '{"text": "hi"}'))
+      expect(ok).toMatchObject({ ok: true, name: 'echo' })
+      const bad = policy.check(call('echo', '{}'))
+      expect(bad).toMatchObject({ ok: false, errorCode: 'SCHEMA_MISMATCH' })
+      expect((bad as { message: string }).message).toContain('must have required property')
+    } finally {
+      await fake.close()
+    }
+  })
+})
