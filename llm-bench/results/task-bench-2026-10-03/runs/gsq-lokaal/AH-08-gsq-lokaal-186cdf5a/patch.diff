+import { Ajv } from 'ajv'
+import type { ValidateFunction } from 'ajv'
+import type { ToolCall, ToolSnapshot } from '../types.js'
+
+export type PolicyDecision =
+  | { ok: true; name: string; args: Record<string, unknown> }
+  | { ok: false; errorCode: 'UNKNOWN_TOOL' | 'MALFORMED_ARGS' | 'SCHEMA_MISMATCH'; message: string }
+
+type Validator = ValidateFunction
+
+/**
+ * Per-call validation in the fixed spec §5.3 order: name → JSON → schema.
+ *
+ * Schema validation is Ajv draft-07: SDK 1.29's registerTool → toJsonSchemaCompat without
+ * target → mapMiniTarget ⇒ 'draft-7', so every emitted inputSchema carries
+ * `$schema: http://json-schema.org/draft-07/schema#`. Ajv2020 refuses that `$schema`
+ * ("no schema with key or ref"), so the base Ajv class is used and the `$schema` key is
+ * stripped from a copy before compile, keeping a later SDK bump to 2020-12 from breaking here.
+ *
+ * Validators are compiled once per tool name at creation. `strict: false` because MCP
+ * schemas contain non-standard keywords Ajv does not know.
+ */
+export function createPolicy(snapshot: ToolSnapshot): { check(call: ToolCall): PolicyDecision } {
+  const ajv = new Ajv({ strict: false, allErrors: false })
+  const validators = new Map<string, Validator>()
+  for (const entry of snapshot.entries) {
+    const schema: Record<string, unknown> = { ...entry.inputSchema }
+    delete schema.$schema
+    validators.set(entry.name, ajv.compile(schema))
+  }
+
+  return {
+    check(call: ToolCall): PolicyDecision {
+      const validator = validators.get(call.name)
+      if (!validator) return { ok: false, errorCode: 'UNKNOWN_TOOL', message: `tool not in snapshot: ${call.name}` }
+
+      let args: unknown
+      try {
+        args = call.arguments === '' ? {} : JSON.parse(call.arguments)
+      } catch {
+        return { ok: false, errorCode: 'MALFORMED_ARGS', message: 'arguments are not valid JSON' }
+      }
+      if (typeof args !== 'object' || args === null || Array.isArray(args)) {
+        return { ok: false, errorCode: 'MALFORMED_ARGS', message: 'arguments are not a JSON object' }
+      }
+      const record = args as Record<string, unknown>
+
+      if (!validator(record)) return { ok: false, errorCode: 'SCHEMA_MISMATCH', message: ajv.errorsText(validator.errors ?? ajv.errors, { separator: '; ' }) }
+      return { ok: true, name: call.name, args: record }
+    },
+  }
+}
