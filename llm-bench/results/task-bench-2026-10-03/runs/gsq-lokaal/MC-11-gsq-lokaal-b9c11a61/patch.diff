index 0000000..537601d
--- /dev/null
+++ b/src/tools/queue-archive.ts
@@ -0,0 +1,132 @@
+// M32 §4.4 — queue_archive / queue_unarchive: recursive subtree cleanup for the
+// s4m-queue. Same subtree/terminal/per-row semantics as the s4m-queue CLI's
+// archiveSubtree/unarchiveSubtree:
+//   • lock the whole reply-subtree rooted at `message_id` (WITH RECURSIVE +
+//     FOR UPDATE) inside one interactive Prisma transaction,
+//   • archive: only allowed while the WHOLE subtree is terminal
+//     (QUEUE_TERMINAL_STATUSES); a still-pending/claimed row blocks with
+//     QUEUE_NOT_TERMINAL (naming the blocking id + status) before any write,
+//   • per-row idempotent: archive touches only rows with archived_at IS NULL
+//     (sets now()); unarchive touches only rows with archived_at IS NOT NULL
+//     (sets NULL) and has NO terminal check,
+//   • no NOTIFY — archiving is bookkeeping, not routing; no other agent is
+//     ever woken up by it.
+import { z } from 'zod'
+import type { CallToolResult } from '@modelcontextprotocol/sdk/types.js'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import type { Prisma } from '@prisma/client'
+import { prisma } from '../prisma.js'
+import { requireWriteAccess } from '../auth.js'
+import { toolJson, withToolErrors } from '../errors.js'
+import { QUEUE_TERMINAL_STATUSES } from '@shared/queue-identity.js'
+
+const inputSchema = z.object({
+  message_id: z.string().uuid(),
+})
+
+interface SubtreeRow {
+  id: string
+  status: string
+}
+
+/**
+ * Locks the full reply-subtree rooted at `rootId` (root + every transitive
+ * reply via in_reply_to) with FOR UPDATE, so concurrent archive/unarchive/
+ * claim calls on the same subtree serialize. Returns [] when the root does
+ * not exist.
+ */
+function lockSubtree(tx: Prisma.TransactionClient, rootId: string): Promise<SubtreeRow[]> {
+  return tx.$queryRaw<SubtreeRow[]>`
+    WITH RECURSIVE subtree AS (
+      SELECT id, status, in_reply_to FROM agent_message WHERE id = ${rootId}::uuid
+      UNION ALL
+      SELECT m.id, m.status, m.in_reply_to
+        FROM agent_message m
+        JOIN subtree s ON m.in_reply_to = s.id
+    )
+    SELECT id, status FROM subtree
+     FOR UPDATE
+  `
+}
+
+async function archiveSubtree(message_id: string): Promise<CallToolResult> {
+  const result = await prisma.$transaction(async (tx) => {
+    const rows = await lockSubtree(tx, message_id)
+    if (rows.length === 0) {
+      throw new Error(`QUEUE_NOT_FOUND: message ${message_id} does not exist`)
+    }
+    const blocking = rows.find(
+      (row) => !(QUEUE_TERMINAL_STATUSES as readonly string[]).includes(row.status),
+    )
+    if (blocking) {
+      throw new Error(
+        `QUEUE_NOT_TERMINAL: message ${blocking.id} is '${blocking.status}' — ` +
+          `only fully-terminal subtrees can be archived`,
+      )
+    }
+    const ids = rows.map((row) => row.id)
+    const { count } = await prisma.agentMessage.updateMany({
+      where: { id: { in: ids }, archived_at: null },
+      data: { archived_at: new Date() },
+    })
+    return { message_id, total: rows.length, archived: count }
+  })
+  return toolJson(result)
+}
+
+async function unarchiveSubtree(message_id: string): Promise<CallToolResult> {
+  const result = await prisma.$transaction(async (tx) => {
+    const rows = await lockSubtree(tx, message_id)
+    if (rows.length === 0) {
+      throw new Error(`QUEUE_NOT_FOUND: message ${message_id} does not exist`)
+    }
+    const ids = rows.map((row) => row.id)
+    const { count } = await prisma.agentMessage.updateMany({
+      where: { id: { in: ids }, archived_at: { not: null } },
+      data: { archived_at: null },
+    })
+    return { message_id, total: rows.length, unarchived: count }
+  })
+  return toolJson(result)
+}
+
+const ARCHIVE_DESCRIPTION =
+  'Archive a queue message together with its full reply-subtree: sets ' +
+  'archived_at on every still-unarchived row. Only allowed while the whole ' +
+  'subtree is terminal (done/failed/cancelled) — otherwise QUEUE_NOT_TERMINAL. ' +
+  'Per-row idempotent: rows that are already archived are not touched again. ' +
+  'Intended for cleanup automation on completed conversations.'
+
+const UNARCHIVE_DESCRIPTION =
+  'Undo queue_archive: clears archived_at on every archived row of the ' +
+  'message and its full reply-subtree. No terminal check — archiving is bookkeeping, ' +
+  'not routing. Per-row idempotent: rows that are not archived are not touched.'
+
+export function registerQueueArchiveTools(server: McpServer) {
+  server.registerTool(
+    'queue_archive',
+    {
+      title: 'Queue archive',
+      description: ARCHIVE_DESCRIPTION,
+      inputSchema,
+    },
+    async ({ message_id }) =>
+      withToolErrors(async () => {
+        await requireWriteAccess()
+        return await archiveSubtree(message_id)
+      }),
+  )
+  server.registerTool(
+    'queue_unarchive',
+    {
+      title: 'Queue unarchive',
+      description: UNARCHIVE_DESCRIPTION,
+      inputSchema,
+    },
+    async ({ message_id }) =>
+      withToolErrors(async () => {
+        await requireWriteAccess()
+        return await unarchiveSubtree(message_id)
+      }),
+  )
+}
