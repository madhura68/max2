+++ b/__tests__/queue-archive.test.ts
@@ -0,0 +1,173 @@
+// M32 §4.4 — queue_archive / queue_unarchive: recursive subtree (WITH RECURSIVE
+// + FOR UPDATE), per-row idempotent archived_at-set/clear. Archiveren vereist
+// dat de subtree volledig terminaal is (done/failed/cancelled) — een nog-pendende
+// of gecureerde rij blokkeert met QUEUE_NOT_TERMINAL; unarchiveert geen
+// terminaal-check. De $transaction-mock roept de callback aan met een tx-object,
+// zodat de lock-query én de updateMany binnen de transactie waargenomen worden.
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+
+const txMock = vi.hoisted(() => ({ $queryRaw: vi.fn() }))
+const mockPrisma = vi.hoisted(() => ({
+  $transaction: vi.fn(async (fn: (tx: unknown) => Promise<unknown>) => fn(txMock)),
+  agentMessage: { updateMany: vi.fn() },
+}))
+
+vi.mock('../src/prisma.js', () => ({ prisma: mockPrisma }))
+vi.mock('../src/auth.js', async (importOriginal) => {
+  const original = await importOriginal<typeof import('../src/auth.js')>()
+  return { ...original, requireWriteAccess: vi.fn() }
+})
+
+import { prisma } from '../src/prisma.js'
+import { requireWriteAccess } from '../src/auth.js'
+import { registerQueueArchiveTools } from '../src/tools/queue-archive.js'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+
+const mockAuth = requireWriteAccess as ReturnType<typeof vi.fn>
+const mockTx = txMock.$queryRaw as ReturnType<typeof vi.fn>
+const mockUpdateMany = mockPrisma.agentMessage.updateMany as ReturnType<typeof vi.fn>
+
+type ToolResult = { isError?: boolean; content: { text: string }[] }
+
+const handlers = new Map<string, (args: Record<string, unknown>) => Promise<unknown>>()
+
+function makeServer() {
+  const server = {
+    registerTool: vi.fn(
+      (name: string, _meta: unknown, fn: (args: Record<string, unknown>) => Promise<unknown>) => {
+        handlers.set(name, fn)
+      },
+    ),
+    call: (name: string, args: Record<string, unknown>) =>
+      (handlers.get(name) as (args: Record<string, unknown>) => Promise<ToolResult>)(args),
+  }
+  registerQueueArchiveTools(server as unknown as McpServer)
+  return server
+}
+
+const ROOT = 'aaaaaaaa-0000-4000-8000-000000000111'
+const CHILD = 'bbbbbbbb-0000-4000-8000-000000000222'
+
+const subtreeRow = (id: string, status: string) => ({
+  id,
+  status,
+  in_reply_to: id === CHILD ? ROOT : null,
+})
+
+function sqlOf(call: unknown[]): string {
+  return (call[0] as readonly string[]).join(' ')
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  handlers.clear()
+  vi.stubEnv('S4M_SERVER', 'mac')
+  vi.stubEnv('S4M_MODEL', 'claude')
+  mockAuth.mockResolvedValue({ userId: 'u', tokenId: 't', username: 'agent', isDemo: false })
+  mockTx.mockResolvedValue([])
+  mockUpdateMany.mockResolvedValue({ count: 0 })
+})
+afterEach(() => vi.unstubAllEnvs())
+
+describe('queue_archive — M32 §4.4', () => {
+  it('archiveert de volledige terminal-subtree per-rij idempotent (updateMany { id: { in: ids }, archived_at: null } → archived_at: Date)', async () => {
+    // De lock-query geeft ROOT + CHILD terug; beide terminaal.
+    mockTx.mockResolvedValueOnce([subtreeRow(ROOT, 'done'), subtreeRow(CHILD, 'done')])
+    mockUpdateMany.mockResolvedValueOnce({ count: 2 })
+
+    const server = makeServer()
+    const before = Date.now()
+    const result = await server.call('queue_archive', { message_id: ROOT })
+    expect(result.isError).toBeUndefined()
+    const body = JSON.parse(result.content[0].text)
+    expect(body).toEqual({ message_id: ROOT, total: 2, archived: 2 })
+
+    // Exact één $queryRaw-call: de WITH RECURSIVE + FOR UPDATE-subtree-query,
+    // geroot op de overgegeven message_id.
+    expect(mockTx).toHaveBeenCalledTimes(1)
+    const lockCall = mockTx.mock.calls[0]
+    expect(sqlOf(lockCall)).toContain('WITH RECURSIVE')
+    expect(sqlOf(lockCall)).toContain('FOR UPDATE')
+    expect(lockCall[1]).toBe(ROOT)
+
+    // Per-rij idempotent: alleen nog-niet-gearchiveerde rijen, alle ids van de
+    // locked subtree, archiveer-moment als Date.
+    expect(mockUpdateMany).toHaveBeenCalledTimes(1)
+    const args = mockUpdateMany.mock.calls[0][0] as {
+      where: Record<string, unknown>
+      data: Record<string, unknown>
+    }
+    expect(args.where).toEqual({
+      id: { in: expect.arrayContaining([ROOT, CHILD]) },
+      archived_at: null,
+    })
+    expect((args.data.archived_at as Date).getTime()).toBeGreaterThanOrEqual(before)
+  })
+
+  it('bLOKKEERT bij een nog-niet-terminale rij in de subtree: QUEUE_NOT_TERMINAL met blokkerende rid + status, géén updateMany', async () => {
+    // ROOT is terminaal maar een reply in de subtree is nog pending: de
+    // archivering moet vóór de update teruggeweken worden.
+    mockTx.mockResolvedValueOnce([subtreeRow(ROOT, 'done'), subtreeRow(CHILD, 'pending')])
+
+    const server = makeServer()
+    const result = await server.call('queue_archive', { message_id: ROOT })
+    expect(result.isError).toBe(true)
+    expect(result.content[0].text).toContain('QUEUE_NOT_TERMINAL')
+    expect(result.content[0].text).toContain(CHILD)
+    expect(result.content[0].text).toContain('pending')
+    expect(mockUpdateMany).not.toHaveBeenCalled()
+  })
+
+  it('QUEUE_NOT_FOUND als de root niet bestaat (géén updateMany)', async () => {
+    mockTx.mockResolvedValueOnce([])
+    const server = makeServer()
+    const result = await server.call('queue_archive', { message_id: ROOT })
+    expect(result.isError).toBe(true)
+    expect(result.content[0].text).toContain('QUEUE_NOT_FOUND')
+    expect(result.content[0].text).toContain(ROOT)
+    expect(mockUpdateMany).not.toHaveBeenCalled()
+  })
+})
+
+describe('queue_unarchive — M32 §4.4', () => {
+  it('cleart archived_at per-rij idempotent ({ archived_at: { not: null } } → null) ZONDER terminaal-check', async () => {
+    // Alleen de lock-query — het unarchiveren filtert géén status.
+    mockTx.mockResolvedValueOnce([
+      subtreeRow(ROOT, 'done'),
+      subtreeRow(CHILD, 'pending'),
+    ])
+    mockUpdateMany.mockResolvedValueOnce({ count: 2 })
+
+    const server = makeServer()
+    const result = await server.call('queue_unarchive', { message_id: ROOT })
+    expect(result.isError).toBeUndefined()
+    const body = JSON.parse(result.content[0].text)
+    expect(body).toEqual({ message_id: ROOT, total: 2, unarchived: 2 })
+
+    // Exact één $queryRaw-call: de lock-query — de terminaal-check ontbreekt.
+    expect(mockTx).toHaveBeenCalledTimes(1)
+    const lockCall = mockTx.mock.calls[0]
+    expect(sqlOf(lockCall)).toContain('WITH RECURSIVE')
+    expect(sqlOf(lockCall)).toContain('FOR UPDATE')
+    expect(lockCall[1]).toBe(ROOT)
+
+    const args = mockUpdateMany.mock.calls[0][0] as {
+      where: Record<string, unknown>
+      data: Record<string, unknown>
+    }
+    expect(args.where).toEqual({
+      id: { in: expect.arrayContaining([ROOT, CHILD]) },
+      archived_at: { not: null },
+    })
+    expect(args.data.archived_at).toBeNull()
+  })
+
+  it('QUEUE_NOT_FOUND als de root niet bestaat (géén updateMany)', async () => {
+    mockTx.mockResolvedValueOnce([])
+    const server = makeServer()
+    const result = await server.call('queue_unarchive', { message_id: ROOT })
+    expect(result.isError).toBe(true)
+    expect(result.content[0].text).toContain('QUEUE_NOT_FOUND')
+    expect(mockUpdateMany).not.toHaveBeenCalled()
+  })
+})
