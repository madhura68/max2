[Unit]
Description=open-webui container -> Ollama bridge (172.30.81.1:11434 -> 127.0.0.1:11434)
After=docker.service ollama.service
Requires=docker.service

[Service]
# The gateway address only exists once the owui-internal network does.
ExecStartPre=/bin/sh -c 'until ip -4 addr show br-owui 2>/dev/null | grep -q 172.30.81.1; do sleep 2; done'
ExecStart=/usr/bin/socat TCP-LISTEN:11434,bind=172.30.81.1,fork,reuseaddr TCP:127.0.0.1:11434
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
